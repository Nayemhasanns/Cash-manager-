function renderIncomeNameField(){
  var cat = catMeta(activeIncomeCat);
  var wrap = qs('#income-name-field-wrap');
  var idGroup = qs('#income-id-group');
  idGroup.style.display = cat.hasId ? 'block' : 'none';

  if(cat.mode === 'kormi-select'){
    var kormiOptions = state.kormiList.map(function(k){
      return '<option value="'+escapeHtml(k.name)+'" data-emp-id="'+escapeHtml(k.empId||'')+'">'+escapeHtml(k.name)+'</option>';
    }).join('');
    wrap.innerHTML =
      '<label>'+escapeHtml(cat.nameLabel)+'</label>'+
      '<select id="income-name" required>'+
      '<option value="">Select employee…</option>'+kormiOptions+
      '<option value="__add_new__">+ Add new employee</option>'+
      '</select>'+
      (state.kormiList.length===0 ? '<div style="font-size:.72rem;color:var(--text-muted);margin-top:6px;">No employees set up yet — add one above or from Settings → Employee Setup.</div>' : '');
    qs('#income-name').addEventListener('change', async function(e){
      if(e.target.value === '__add_new__'){
        var result = await kormiDialog(null);
        if(result){
          state.kormiList.push({id:uid(), name:result.name, empId:result.empId});
          flushSave();
          renderIncomeNameField();
          renderKormiSetupList();
          setTimeout(function(){
            var f = qs('#income-name');
            f.value = result.name;
            var empIdInput = qs('#income-emp-id');
            if(empIdInput) empIdInput.value = result.empId||'';
          }, 0);
        } else { e.target.value = ''; }
        return;
      }
      var selected = e.target.selectedOptions[0];
      var empIdInput = qs('#income-emp-id');
      if(empIdInput) empIdInput.value = selected ? (selected.dataset.empId||'') : '';
    });
  } else if(cat.mode === 'text'){
    var listId = 'dl-'+cat.knownKey;
    var known = (state.knownNames[cat.knownKey]||[]);
    wrap.innerHTML =
      '<label>'+escapeHtml(cat.nameLabel)+'</label>'+
      '<input type="text" id="income-name" list="'+listId+'" placeholder="Enter '+escapeHtml(cat.nameLabel.toLowerCase())+'" required>'+
      '<datalist id="'+listId+'">'+known.map(function(n){ return '<option value="'+escapeHtml(n)+'">'; }).join('')+'</datalist>';
  } else {
    var options = state.customIncomeCategories.map(function(n){
      return '<option value="'+escapeHtml(n)+'">'+escapeHtml(n)+'</option>';
    }).join('');
    wrap.innerHTML =
      '<label>'+escapeHtml(cat.nameLabel)+'</label>'+
      '<select id="income-name" required>'+
      '<option value="">Select category…</option>'+options+
      '<option value="__add_new__">+ Add new category</option>'+
      '</select>';
    qs('#income-name').addEventListener('change', async function(e){
      if(e.target.value === '__add_new__'){
        var name = await inputDialog('New income category', 'e.g. Commission');
        if(name){
          state.customIncomeCategories.push(name);
          saveState();
          renderIncomeNameField();
          setTimeout(function(){ qs('#income-name').value = name; }, 0);
        } else { e.target.value = ''; }
      }
    });
  }
}

qs('#income-date').value = todayKey();

qs('#income-form').addEventListener('submit', function(e){
  e.preventDefault();
  var cat = catMeta(activeIncomeCat);
  var nameField = qs('#income-name');
  var name = nameField ? nameField.value.trim() : '';
  var date = qs('#income-date').value;
  var remarks = qs('#income-remarks').value.trim();
  var empId = qs('#income-emp-id') ? qs('#income-emp-id').value.trim() : '';
  var denoms = getDenomValues(incomeDenomGrid);
  var total = getDenomTotal(incomeDenomGrid);
  var vangtiDenoms = getDenomValues(incomeVangtiGrid);
  var vangtiTotal = getDenomTotal(incomeVangtiGrid);

  if(!name){ toast('Please enter a name / category', 'error'); return; }
  if(!date){ toast('Please pick a date', 'error'); return; }
  if(total <= 0){ toast('Enter at least one note quantity', 'error'); return; }
  if(vangtiTotal > total){ toast('Change cannot be more than the collected total', 'error'); return; }

  commitTransaction({
    id: uid(), type:'income', categoryKey: cat.key, categoryLabel: cat.full,
    name: name, employeeId: empId, date: date, remarks: remarks,
    denoms: denoms, total: total,
    vangtiDenoms: vangtiDenoms, vangtiTotal: vangtiTotal,
    createdAt: Date.now()
  });

  if(cat.mode==='text' && cat.knownKey){
    state.knownNames[cat.knownKey] = state.knownNames[cat.knownKey] || [];
    if(state.knownNames[cat.knownKey].indexOf(name) === -1){
      state.knownNames[cat.knownKey].push(name);
    }
  }
  flushSave();

  nameField.value = '';
  if(qs('#income-emp-id')) qs('#income-emp-id').value = '';
  qs('#income-remarks').value = '';
  qs('#income-date').value = todayKey();
  resetDenomGrid(incomeDenomGrid, incomeTotalEl);
  resetDenomGrid(incomeVangtiGrid, incomeVangtiTotalEl);
  updateIncomeNet();
  var incomeVangtiSectionEl = qs('#income-vangti-section');
  if(incomeVangtiSectionEl) incomeVangtiSectionEl.classList.remove('expanded');
  toast('Income entry saved — '+formatMoney(total)+(vangtiTotal>0?' (vangti '+formatMoney(vangtiTotal)+')':''), 'success');
  updateAfterTransaction();
});

