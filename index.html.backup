<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Cash Collection &amp; Expense Manager</title>
<style>
/* ============================================================
   TOKENS
   ============================================================ */
:root[data-theme="dark"]{
  --bg1:#0b1e23; --bg2:#173741; --bg3:#22525f;
  --glass-bg: rgba(255,255,255,0.06);
  --glass-bg-strong: rgba(255,255,255,0.10);
  --glass-border: rgba(255,255,255,0.14);
  --text:#eaf3f4; --text-muted:#9db4ba;
  --accent-gold:#e8c468; --accent-gold-dim:#a98a49;
  --accent-green:#3ddc97; --accent-green-dim:#1f7a55;
  --accent-red:#ff7676; --accent-red-dim:#a13c3c;
  --accent-blue:#6ec6ff;
  --shadow: 0 10px 34px rgba(0,0,0,0.40);
  --overlay: rgba(4,10,12,0.6);
  --input-bg: rgba(255,255,255,0.05);
}
:root[data-theme="light"]{
  --bg1:#eef6f6; --bg2:#d6ebec; --bg3:#bcdde0;
  --glass-bg: rgba(255,255,255,0.55);
  --glass-bg-strong: rgba(255,255,255,0.75);
  --glass-border: rgba(20,60,64,0.14);
  --text:#0d2b2f; --text-muted:#4d6a6e;
  --accent-gold:#a9750f; --accent-gold-dim:#c99a3d;
  --accent-green:#128a5c; --accent-green-dim:#1fb379;
  --accent-red:#c83939; --accent-red-dim:#e06767;
  --accent-blue:#1f7bb3;
  --shadow: 0 10px 30px rgba(30,60,64,0.14);
  --overlay: rgba(20,40,42,0.35);
  --input-bg: rgba(20,60,64,0.05);
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;height:100%;}
body{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  color:var(--text);
  min-height:100vh;
  background:linear-gradient(135deg,var(--bg1),var(--bg2),var(--bg3));
  background-size:220% 220%;
  background-position:35% 45%;
  overflow-x:hidden;
}
h1,h2,h3,h4{margin:0 0 4px 0;font-weight:700;letter-spacing:.2px;}
p{margin:0;}
button{font-family:inherit;}
::selection{background:var(--accent-gold);color:#111;}

.mono{
  font-family:"SFMono-Regular",Consolas,"Courier New",monospace;
  font-variant-numeric:tabular-nums;
}

/* ============================================================
   LAYOUT SHELL
   ============================================================ */
#app{
  max-width:640px;
  margin:0 auto;
  min-height:100vh;
  padding-bottom:92px;
  position:relative;
}

.topbar{
  position:sticky;top:0;z-index:40;
  display:flex;align-items:center;justify-content:space-between;
  padding:16px 16px 12px 16px;
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
  background:linear-gradient(180deg,rgba(0,0,0,0.18),rgba(0,0,0,0));
}
.brand{display:flex;align-items:center;gap:10px;}
.brand-icon{
  width:38px;height:38px;border-radius:12px;
  background:var(--glass-bg-strong);border:1px solid var(--glass-border);
  display:flex;align-items:center;justify-content:center;
  box-shadow:var(--shadow);
}
.brand-text h1{font-size:1.05rem;line-height:1.1;}
.brand-text span{font-size:.72rem;color:var(--text-muted);}
.theme-toggle{
  width:44px;height:44px;border-radius:14px;
  background:var(--glass-bg);border:1px solid var(--glass-border);
  display:flex;align-items:center;justify-content:center;cursor:pointer;
  transition:transform .2s ease,background .2s ease;
}
.theme-toggle:active{transform:scale(.9);}

main{padding:0 14px;}

.view{display:none;animation:viewIn .32s ease;}
.view.active{display:block;}
@keyframes viewIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}

.view-header{margin:6px 2px 14px 2px;}
.view-header p{color:var(--text-muted);font-size:.82rem;margin-top:2px;}

/* ============================================================
   GLASS CARD PRIMITIVES
   ============================================================ */
.glass-card{
  background:var(--glass-bg);
  border:1px solid var(--glass-border);
  border-radius:20px;
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  box-shadow:var(--shadow);
}
.card-pad{padding:16px;}

.stat-grid{
  display:grid;grid-template-columns:1fr 1fr;gap:10px;
  margin-bottom:14px;
}
.stat-card{
  padding:14px;position:relative;overflow:hidden;
}
.stat-card .stat-label{font-size:.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.6px;}
.stat-card .stat-value{
  font-size:1.32rem;font-weight:700;margin-top:6px;
  font-family:"SFMono-Regular",Consolas,"Courier New",monospace;
  font-variant-numeric:tabular-nums;
}
.stat-card.income .stat-value{color:var(--accent-green);}
.stat-card.expense .stat-value{color:var(--accent-red);}
.stat-card.balance .stat-value{color:var(--accent-gold);}
.stat-card .stat-icon{
  position:absolute;right:10px;top:10px;opacity:.35;
}
.stat-card.full{grid-column:1 / -1;}

.section-title{
  display:flex;align-items:center;justify-content:space-between;
  margin:20px 2px 10px 2px;
}
.section-title h3{font-size:.95rem;}
.section-title .link-btn{font-size:.78rem;color:var(--accent-blue);cursor:pointer;background:none;border:none;}

.recent-item{
  display:flex;align-items:center;gap:10px;
  padding:10px 4px;border-bottom:1px solid var(--glass-border);
  cursor:pointer;transition:background .15s ease;border-radius:8px;
}
.recent-item:hover{background:var(--glass-bg-strong);}
.recent-item:last-child{border-bottom:none;}
.recent-icon{
  width:34px;height:34px;border-radius:10px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  background:var(--glass-bg-strong);
}
.recent-info{flex:1;min-width:0;}
.recent-info .rt{font-size:.86rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.recent-info .rs{font-size:.72rem;color:var(--text-muted);}
.recent-amt{font-family:monospace;font-weight:700;font-size:.86rem;white-space:nowrap;}
.recent-amt.income{color:var(--accent-green);}
.recent-amt.expense{color:var(--accent-red);}
.empty-note{padding:18px 4px;text-align:center;color:var(--text-muted);font-size:.85rem;}

.app-footer{
  margin-top:28px;padding:0 4px 8px 4px;text-align:center;
}
.footer-rule{
  height:1px;margin:0 auto 16px auto;max-width:220px;
  background:linear-gradient(90deg,transparent,var(--glass-border) 20%,var(--glass-border) 80%,transparent);
}
.app-footer p{
  font-size:.72rem;color:var(--text-muted);letter-spacing:.3px;margin:0;
}
.footer-name{
  color:var(--accent-gold);font-weight:600;
  text-shadow:0 0 10px rgba(232,196,104,0.25);
}

.kormi-row{
  display:flex;align-items:center;gap:10px;
  padding:10px 4px;border-bottom:1px solid var(--glass-border);
}
.kormi-row:last-child{border-bottom:none;}
.kormi-row .kr-info{flex:1;min-width:0;}
.kormi-row .kr-name{font-size:.88rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.kormi-row .kr-id{font-size:.72rem;color:var(--text-muted);font-family:monospace;}
.kormi-row .kr-actions{display:flex;gap:6px;flex-shrink:0;}
.kormi-row .kr-btn{
  width:32px;height:32px;border-radius:9px;border:1px solid var(--glass-border);
  background:var(--glass-bg);display:flex;align-items:center;justify-content:center;cursor:pointer;
  color:var(--text-muted);transition:background .15s ease;
}
.kormi-row .kr-btn:hover{background:var(--glass-bg-strong);}
.kormi-row .kr-btn.danger:hover{color:var(--accent-red);}

/* ============================================================
   CHIPS / TABS
   ============================================================ */
.chip-row{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;margin-bottom:14px;scrollbar-width:none;}
.chip-row::-webkit-scrollbar{display:none;}
.chip{
  flex-shrink:0;padding:9px 14px;border-radius:999px;
  background:var(--glass-bg);border:1px solid var(--glass-border);
  font-size:.8rem;cursor:pointer;white-space:nowrap;color:var(--text-muted);
  transition:all .2s ease;
}
.chip.active{
  background:var(--accent-gold);color:#1a1405;border-color:var(--accent-gold);font-weight:700;
}

/* ============================================================
   FORMS
   ============================================================ */
.form-card{padding:18px;margin-bottom:16px;}
.field-group{margin-bottom:14px;}
.field-group label{display:block;font-size:.78rem;color:var(--text-muted);margin-bottom:6px;font-weight:600;}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
input[type="text"],input[type="date"],input[type="number"],select,textarea,.text-input{
  width:100%;padding:11px 12px;border-radius:11px;
  border:1px solid var(--glass-border);background:var(--input-bg);
  color:var(--text);font-size:.92rem;outline:none;
  transition:border-color .2s ease,background .2s ease;
}
input:focus,select:focus,textarea:focus{border-color:var(--accent-gold);background:rgba(232,196,104,0.06);}
textarea{resize:vertical;min-height:52px;font-family:inherit;}
select{appearance:none;-webkit-appearance:none;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6'><path d='M0 0 L5 6 L10 0 Z' fill='%239db4ba'/></svg>");background-repeat:no-repeat;background-position:right 12px center;}

.denom-section h3{font-size:.85rem;color:var(--text-muted);margin-bottom:10px;text-transform:uppercase;letter-spacing:.5px;}
.denom-grid{display:flex;flex-direction:column;gap:8px;margin-bottom:14px;}
.denom-row{
  display:grid;grid-template-columns:56px 1fr 92px;gap:10px;align-items:center;
}
.denom-chip{
  background:var(--glass-bg-strong);border:1px solid var(--glass-border);
  border-radius:10px;text-align:center;padding:9px 0;font-weight:700;
  font-family:"SFMono-Regular",Consolas,monospace;font-size:.85rem;
}
.denom-row input{text-align:center;padding:9px 6px;width:100%;}
.denom-input-wrap{display:flex;flex-direction:column;gap:2px;}
.denom-available{
  font-size:.66rem;text-align:center;color:var(--text-muted);font-family:monospace;
}
.denom-available.over{color:var(--accent-red);font-weight:700;}
.denom-subtotal{
  font-family:monospace;text-align:right;color:var(--text-muted);font-size:.82rem;padding-right:2px;
}

.total-display{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 16px;border-radius:14px;margin:14px 0 16px 0;
  background:rgba(0,0,0,0.18);border:1px solid var(--glass-border);
}
.total-display span{font-size:.8rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.6px;}
.counter-display{
  font-family:"SFMono-Regular",Consolas,"Courier New",monospace;
  font-variant-numeric:tabular-nums;
  background:rgba(0,0,0,0.35);
  border:1px solid var(--glass-border);
  border-radius:10px;padding:8px 14px;
  font-size:1.5rem;font-weight:700;color:var(--accent-gold);
  text-shadow:0 0 14px rgba(232,196,104,0.45);
  letter-spacing:.5px;
}

/* ============================================================
   VANGTI (CHANGE RETURNED) — side-by-side with main denominations
   ============================================================ */
.denom-cols{
  display:flex;flex-wrap:wrap;gap:14px;
}
.denom-cols > .denom-section{
  flex:1 1 240px;min-width:0;
}
.vangti-section{
  padding:12px;border-radius:14px;
  background:rgba(255,118,118,0.06);
  border:1px solid rgba(255,118,118,0.22);
}
.vangti-section h3{color:var(--accent-red);margin:0;}
.vangti-header{
  display:flex;align-items:center;gap:8px;cursor:pointer;
  -webkit-tap-highlight-color:transparent;
}
.vangti-badge{
  font-size:.76rem;font-weight:700;color:var(--accent-red);
  font-family:monospace;margin-left:auto;
}
.vangti-toggle-btn{
  display:flex;align-items:center;justify-content:center;
  width:26px;height:26px;flex-shrink:0;border-radius:8px;
  border:1px solid rgba(255,118,118,0.3);background:rgba(255,118,118,0.08);
  color:var(--accent-red);cursor:pointer;transition:transform .2s ease;
}
.vangti-section.expanded .vangti-toggle-btn{transform:rotate(180deg);}
.vangti-body{display:none;margin-top:10px;}
.vangti-section.expanded .vangti-body{display:block;}
.vangti-total .counter-display{
  color:var(--accent-red);text-shadow:0 0 14px rgba(255,118,118,0.4);font-size:1.2rem;
}
.net-line{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 16px;margin:-6px 0 16px 0;font-size:.82rem;color:var(--text-muted);
}
.net-line .net-value{font-family:monospace;font-weight:700;color:var(--text);}

.btn-primary,.btn-secondary,.btn-danger{
  border:none;border-radius:13px;padding:13px 18px;font-size:.92rem;font-weight:700;
  cursor:pointer;width:100%;transition:transform .15s ease,filter .15s ease;
}
.btn-primary{background:linear-gradient(135deg,var(--accent-gold),var(--accent-gold-dim));color:#1a1405;}
.btn-secondary{background:var(--glass-bg-strong);color:var(--text);border:1px solid var(--glass-border);}
.btn-danger{background:linear-gradient(135deg,var(--accent-red),var(--accent-red-dim));color:#fff;}
.btn-primary:active,.btn-secondary:active,.btn-danger:active{transform:scale(.97);}
.btn-row{display:flex;gap:10px;}
.btn-row>*{width:auto;flex:1;}

/* ============================================================
   NOTE SUMMARY
   ============================================================ */
.note-table{width:100%;border-collapse:collapse;margin-top:6px;}
.note-table th{font-size:.7rem;text-transform:uppercase;color:var(--text-muted);text-align:left;padding:6px 4px;letter-spacing:.5px;border-bottom:1px solid var(--glass-border);}
.note-table td{padding:9px 4px;border-bottom:1px solid var(--glass-border);font-size:.88rem;}
.note-table tr:last-child td{border-bottom:none;}
.note-table td.num{font-family:monospace;text-align:right;}
.note-total-row td{font-weight:700;color:var(--accent-gold);font-family:monospace;}

/* ============================================================
   HISTORY
   ============================================================ */
.filter-card{padding:14px;margin-bottom:14px;}
.filter-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;}
.history-table-wrap{overflow-x:auto;}
table.hist-table{width:100%;border-collapse:collapse;min-width:560px;}
table.hist-table th{font-size:.68rem;text-transform:uppercase;letter-spacing:.4px;color:var(--text-muted);text-align:left;padding:8px 6px;border-bottom:1px solid var(--glass-border);position:sticky;top:0;}
table.hist-table td{padding:9px 6px;border-bottom:1px solid var(--glass-border);font-size:.82rem;vertical-align:top;}
table.hist-table tbody tr{cursor:pointer;transition:background .15s ease;}
table.hist-table tbody tr:hover{background:var(--glass-bg-strong);}
table.hist-table tr:last-child td{border-bottom:none;}
.tag{display:inline-block;padding:2px 8px;border-radius:999px;font-size:.68rem;font-weight:700;}
.tag.income{background:rgba(61,220,151,0.15);color:var(--accent-green);}
.tag.expense{background:rgba(255,118,118,0.15);color:var(--accent-red);}
.amt-cell{font-family:monospace;font-weight:700;white-space:nowrap;}
.view-detail-btn{
  display:inline-flex;align-items:center;justify-content:center;
  width:28px;height:28px;border-radius:8px;border:1px solid var(--glass-border);
  background:var(--glass-bg);color:var(--accent-blue);cursor:pointer;
  transition:all .18s ease;flex-shrink:0;
}
.view-detail-btn:hover{background:var(--accent-blue);color:#fff;border-color:var(--accent-blue);}
.view-detail-btn svg{width:14px;height:14px;}
.view-detail-btn.edit-btn{color:var(--accent-gold);}
.view-detail-btn.edit-btn:hover{background:var(--accent-gold);border-color:var(--accent-gold);color:#1a1405;}
.view-detail-btn.delete-btn{color:var(--accent-red);}
.view-detail-btn.delete-btn:hover{background:var(--accent-red);border-color:var(--accent-red);color:#fff;}
.view-detail-btn.restore-btn{color:var(--accent-green);}
.view-detail-btn.restore-btn:hover{background:var(--accent-green);border-color:var(--accent-green);color:#0b1e23;}
.row-actions{display:flex;gap:6px;}

/* ============================================================
   REPORTS
   ============================================================ */
.report-btn-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;}
.report-btn{
  padding:16px 10px;text-align:center;cursor:pointer;
  display:flex;flex-direction:column;align-items:center;gap:8px;
}
.report-btn span{font-size:.8rem;font-weight:600;}
#report-output{margin-top:6px;}
.report-block{padding:16px;margin-bottom:14px;}
.report-block h3{font-size:1rem;margin-bottom:2px;}
.report-block .sub{color:var(--text-muted);font-size:.76rem;margin-bottom:12px;}
.report-row{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px dashed var(--glass-border);font-size:.86rem;}
.report-row:last-child{border-bottom:none;}
.report-row .amt{font-family:monospace;font-weight:700;}

/* ============================================================
   BOTTOM NAV + FAB
   ============================================================ */
.bottomnav{
  position:fixed;bottom:0;left:0;right:0;z-index:50;
  max-width:640px;margin:0 auto;
  display:flex;justify-content:space-around;align-items:center;
  padding:10px 6px calc(10px + env(safe-area-inset-bottom)) 6px;
  background:rgba(10,20,22,0.55);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border-top:1px solid var(--glass-border);
}
:root[data-theme="light"] .bottomnav{background:rgba(255,255,255,0.65);}
.nav-btn{
  background:none;border:none;color:var(--text-muted);
  display:flex;flex-direction:column;align-items:center;gap:3px;
  font-size:.62rem;cursor:pointer;padding:4px 8px;border-radius:10px;
  transition:color .2s ease;
}
.nav-btn.active{color:var(--accent-gold);}
.nav-btn svg{width:20px;height:20px;}

.fab{
  position:fixed;right:calc(50% - 320px + 20px);bottom:78px;z-index:55;
  width:56px;height:56px;border-radius:50%;
  background:linear-gradient(135deg,var(--accent-gold),var(--accent-gold-dim));
  border:none;box-shadow:0 8px 22px rgba(232,196,104,0.4);
  display:flex;align-items:center;justify-content:center;cursor:pointer;
  transition:transform .2s ease;
}
@media (max-width:680px){.fab{right:20px;}}
.fab:active{transform:scale(.9) rotate(90deg);}
.fab svg{width:26px;height:26px;}

/* ============================================================
   MODAL / SHEET / TOAST
   ============================================================ */
.modal-overlay{
  position:fixed;inset:0;background:var(--overlay);z-index:100;
  display:flex;align-items:flex-end;justify-content:center;
  animation:fadeIn .2s ease;
}
@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
.modal{
  width:100%;max-width:640px;padding:22px;
  border-radius:22px 22px 0 0;
  animation:slideUp .25s ease;
  max-height:82vh;overflow-y:auto;
}
@keyframes slideUp{from{transform:translateY(30px);opacity:0;}to{transform:translateY(0);opacity:1;}}
.modal h3{margin-bottom:14px;}
.modal-actions{display:flex;gap:10px;margin-top:16px;}
.modal-actions>*{flex:1;}
.sheet-option{
  display:flex;align-items:center;gap:12px;padding:14px;
  border-radius:14px;background:var(--glass-bg-strong);border:1px solid var(--glass-border);
  margin-bottom:10px;cursor:pointer;
}
.sheet-option .so-icon{
  width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,0.08);
}
.sheet-option span{font-weight:600;font-size:.9rem;}

/* ============================================================
   TRANSACTION DETAIL MODAL
   ============================================================ */
.tx-detail-overlay{
  position:fixed;inset:0;background:var(--overlay);z-index:110;
  display:flex;align-items:center;justify-content:center;
  animation:fadeIn .22s ease;
  padding:0;
}
.tx-detail-modal{
  background:var(--bg2);
  border:1px solid var(--glass-border);
  box-shadow:0 20px 60px rgba(0,0,0,0.55);
  width:92%;
  max-width:560px;
  max-height:88vh;
  border-radius:20px;
  overflow-y:auto;
  animation:txModalIn .28s cubic-bezier(0.22,0.61,0.36,1);
  position:relative;
  display:flex;
  flex-direction:column;
}
@keyframes txModalIn{from{opacity:0;transform:scale(.94) translateY(18px);}to{opacity:1;transform:scale(1) translateY(0);}}
.tx-detail-modal .tx-header{
  position:sticky;top:0;z-index:5;
  display:flex;align-items:center;justify-content:space-between;
  padding:16px 18px 12px 18px;
  background:var(--bg2);
  border-bottom:1px solid var(--glass-border);
  border-radius:20px 20px 0 0;
}
.tx-detail-modal .tx-header h3{font-size:1rem;margin:0;}
.tx-detail-modal .tx-close-btn{
  width:34px;height:34px;border-radius:50%;border:1px solid var(--glass-border);
  background:var(--glass-bg);color:var(--text);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:all .18s ease;flex-shrink:0;
}
.tx-detail-modal .tx-close-btn:hover{background:var(--accent-red);color:#fff;border-color:var(--accent-red);}
.tx-detail-modal .tx-body{padding:16px 18px;flex:1;overflow-y:auto;}
.tx-detail-modal .tx-footer{
  position:sticky;bottom:0;z-index:5;
  display:flex;flex-wrap:wrap;gap:10px;padding:14px 18px;
  background:var(--bg2);border-top:1px solid var(--glass-border);
  border-radius:0 0 20px 20px;
}
.tx-detail-modal .tx-footer button{flex:1 1 45%;}

.tx-meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 14px;margin-bottom:14px;}
.tx-meta-item{display:flex;flex-direction:column;gap:3px;}
.tx-meta-item .tx-meta-label{font-size:.68rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;}
.tx-meta-item .tx-meta-value{font-size:.88rem;font-weight:600;word-break:break-word;}
.tx-meta-full{grid-column:1/-1;}

.tx-badge-large{
  display:inline-flex;align-items:center;gap:6px;
  padding:6px 14px;border-radius:999px;font-size:.82rem;font-weight:700;
  margin-bottom:12px;
}
.tx-badge-large.income{background:rgba(61,220,151,0.18);color:var(--accent-green);}
.tx-badge-large.expense{background:rgba(255,118,118,0.18);color:var(--accent-red);}

.tx-denom-table{width:100%;border-collapse:collapse;margin-top:6px;}
.tx-denom-table th{font-size:.7rem;text-transform:uppercase;color:var(--text-muted);text-align:left;padding:6px 4px;border-bottom:1px solid var(--glass-border);letter-spacing:.4px;}
.tx-denom-table td{padding:7px 4px;border-bottom:1px solid var(--glass-border);font-size:.84rem;}
.tx-denom-table td.num{font-family:monospace;text-align:right;}
.tx-denom-table tr.zero-row td{opacity:.45;}
.tx-denom-table .grand-total td{font-weight:700;color:var(--accent-gold);font-family:monospace;font-size:.92rem;border-bottom:none;padding-top:10px;}

/* Mobile full-screen */
@media (max-width:640px){
  .tx-detail-overlay{padding:0;align-items:stretch;}
  .tx-detail-modal{
    width:100%;max-width:100%;height:100vh;max-height:100vh;
    border-radius:0;margin:0;
  }
  .tx-detail-modal .tx-header{border-radius:0;}
  .tx-detail-modal .tx-footer{border-radius:0;}
}

/* Print: transaction detail */
@media print{
  body.tx-printing *{visibility:hidden;}
  body.tx-printing .tx-detail-overlay,
  body.tx-printing .tx-detail-overlay *{visibility:visible;}
  body.tx-printing .tx-detail-overlay{
    position:absolute;inset:auto;top:0;left:0;width:100%;background:#fff;
    z-index:9999;padding:0;
  }
  body.tx-printing .tx-detail-modal{
    box-shadow:none;border:2px solid #ccc;background:#fff!important;
    width:100%;max-width:100%;max-height:none;border-radius:0;
    color:#000!important;
  }
  body.tx-printing .tx-detail-modal *{color:#000!important;}
  body.tx-printing .tx-detail-modal .tx-header,
  body.tx-printing .tx-detail-modal .tx-footer{border-color:#ccc;background:#f9f9f9;}
  body.tx-printing .tx-close-btn,
  body.tx-printing .tx-footer button{display:none;}
  body.tx-printing .tx-denom-table th,
  body.tx-printing .tx-denom-table td{border-color:#ddd;}
}

#toast-root{position:fixed;top:14px;left:0;right:0;z-index:200;display:flex;flex-direction:column;align-items:center;gap:8px;pointer-events:none;}
.toast{
  max-width:88%;padding:11px 18px;border-radius:12px;
  background:rgba(10,20,22,0.9);color:#fff;font-size:.85rem;
  box-shadow:var(--shadow);opacity:0;transform:translateY(-14px);
  transition:all .3s ease;border:1px solid var(--glass-border);
}
.toast.show{opacity:1;transform:translateY(0);}
.toast.toast-success{border-color:var(--accent-green);}
.toast.toast-error{border-color:var(--accent-red);}

#loader{
  position:fixed;inset:0;z-index:500;display:flex;align-items:center;justify-content:center;
  background:linear-gradient(135deg,var(--bg1),var(--bg2),var(--bg3));
  flex-direction:column;gap:14px;
}
.spinner{
  width:44px;height:44px;border-radius:50%;
  border:4px solid rgba(232,196,104,0.2);border-top-color:var(--accent-gold);
  animation:spin .8s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg);}}
#loader span{color:var(--text-muted);font-size:.82rem;letter-spacing:.4px;}

.settings-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 4px;border-bottom:1px solid var(--glass-border);
}
.settings-row:last-child{border-bottom:none;}
.settings-row .sr-label{font-size:.88rem;font-weight:600;}
.settings-row .sr-sub{font-size:.72rem;color:var(--text-muted);margin-top:2px;}
.switch{
  width:46px;height:26px;border-radius:999px;background:var(--glass-bg-strong);
  border:1px solid var(--glass-border);position:relative;cursor:pointer;
}
.switch::after{
  content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;
  background:var(--text-muted);transition:all .2s ease;
}
:root[data-theme="light"] .switch::after{background:var(--accent-gold);left:22px;}
.file-btn{position:relative;overflow:hidden;}
.file-btn input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;}

.lang-toggle{display:flex;border:1px solid var(--glass-border);border-radius:10px;overflow:hidden;flex-shrink:0;}
.lang-btn{
  padding:7px 13px;font-size:.78rem;font-weight:700;background:transparent;border:none;
  color:var(--text-muted);cursor:pointer;-webkit-tap-highlight-color:transparent;
}
.lang-btn.active{background:var(--accent-gold);color:#1a1405;}

@media (max-width:360px){
  .stat-card .stat-value{font-size:1.1rem;}
  .counter-display{font-size:1.2rem;}
}
</style>
</head>
<body>

<div id="loader"><div class="spinner"></div><span>Loading cash ledger…</span></div>

<div id="app">
  <header class="topbar">
    <div class="brand">
      <div class="brand-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="3"></circle><path d="M6 6v0M18 18v0"></path></svg>
      </div>
      <div class="brand-text">
        <h1>Cash Manager</h1>
        <span>Cash Collection &amp; Expense Manager</span>
      </div>
    </div>
    <div class="theme-toggle" id="theme-toggle" title="Toggle theme">
      <svg id="theme-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></svg>
    </div>
  </header>

  <main>

    <!-- ============ DASHBOARD ============ -->
    <section id="view-dashboard" class="view active">
      <div class="view-header"><h2 data-i18n="dashTitle">Dashboard</h2><p data-i18n="dashSub">Live overview of today's cash position</p></div>
      <div class="stat-grid">
        <div class="glass-card stat-card income"><div class="stat-label" data-i18n="statTodayCollection">Today's Collection</div><div class="stat-value mono" id="stat-today-income">৳0</div></div>
        <div class="glass-card stat-card expense"><div class="stat-label" data-i18n="statTodayExpense">Today's Expense</div><div class="stat-value mono" id="stat-today-expense">৳0</div></div>
        <div class="glass-card stat-card balance"><div class="stat-label" data-i18n="statCurrentBalance">Current Cash Balance</div><div class="stat-value mono" id="stat-balance">৳0</div></div>
        <div class="glass-card stat-card balance"><div class="stat-label" data-i18n="statCashInHand">Cash in Hand</div><div class="stat-value mono" id="stat-cash-hand">৳0</div></div>
        <div class="glass-card stat-card full"><div class="stat-label" data-i18n="statTotalTx">Total Transactions</div><div class="stat-value mono" id="stat-total-tx">0</div></div>
      </div>
      <div class="section-title"><h3 data-i18n="sectEmployeeCollection">Today's Employee Collection</h3></div>
      <div class="glass-card card-pad" id="kormi-total-list"></div>
      <div class="section-title"><h3 data-i18n="sectInsuranceCollection">Today's Insurance Collection</h3></div>
      <div class="glass-card card-pad" id="bima-total-list"></div>
      <div class="section-title"><h3 data-i18n="sectLoanDisbursement">Today's Loan Disbursement</h3></div>
      <div class="glass-card card-pad" id="loan-total-list"></div>
      <div class="section-title"><h3 data-i18n="sectRevenueStamp">Revenue Stamp</h3></div>
      <div class="glass-card card-pad">
        <div class="total-display" style="margin:0;">
          <span>Today's Revenue Stamp</span>
          <div class="counter-display" id="revenue-stamp-amount">৳0</div>
        </div>
        <div style="font-size:.72rem;color:var(--text-muted);margin-top:10px;" id="revenue-stamp-sub"></div>
      </div>
      <div class="section-title"><h3 data-i18n="sectRecentTx">Recent Transactions</h3><button class="link-btn" data-i18n="seeAll" onclick="switchView('history')">See all</button></div>
      <div class="glass-card card-pad" id="recent-list"></div>
    </section>

    <!-- ============ INCOME ============ -->
    <section id="view-income" class="view">
      <div class="view-header"><h2 data-i18n="incomeTitle">Income</h2><p data-i18n="incomeSub">Record cash collections by denomination</p></div>
      <div class="chip-row" id="income-cat-chips"></div>
      <form class="glass-card form-card" id="income-form">
        <div class="field-group" id="income-name-field-wrap"></div>
        <div class="field-group" id="income-id-group" style="display:none;"><label>Employee ID (optional)</label><input type="text" id="income-emp-id" placeholder="e.g. EMP-014"></div>
        <div class="field-row"><div class="field-group"><label data-i18n="labelDate">Date</label><input type="date" id="income-date" required></div></div>
        <div class="field-group"><label data-i18n="labelRemarks">Remarks</label><textarea id="income-remarks" placeholder="Optional note"></textarea></div>
        <div class="denom-cols">
          <div class="denom-section"><h3 data-i18n="labelCashDenoms">Cash Denominations</h3><div class="denom-grid" id="income-denom-grid"></div></div>
          <div class="denom-section vangti-section" id="income-vangti-section">
            <div class="vangti-header" id="income-vangti-toggle">
              <h3 data-i18n="labelChangeReturned">Change Returned</h3>
              <span class="vangti-badge" id="income-vangti-badge"></span>
              <button type="button" class="vangti-toggle-btn" aria-expanded="false" aria-label="Expand vangti section">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
              </button>
            </div>
            <div class="vangti-body">
              <div class="denom-grid" id="income-vangti-denom-grid"></div>
              <div class="total-display vangti-total"><span>Change Total</span><div class="counter-display" id="income-vangti-total">৳0</div></div>
            </div>
          </div>
        </div>
        <div class="total-display"><span data-i18n="labelGrandTotal">Grand Total</span><div class="counter-display" id="income-total">৳0</div></div>
        <div class="net-line"><span>Net Cash In (after change)</span><span class="net-value" id="income-net-total">৳0</span></div>
        <button type="submit" class="btn-primary" data-i18n="saveIncomeEntry">Save Income Entry</button>
      </form>
    </section>

    <!-- ============ EXPENSE ============ -->
    <section id="view-expense" class="view">
      <div class="view-header"><h2 data-i18n="expenseTitle">Expense</h2><p data-i18n="expenseSub">Record cash paid out by denomination</p></div>
      <div class="chip-row" id="expense-cat-chips"></div>
      <form class="glass-card form-card" id="expense-form">
        <div class="field-group" id="expense-name-field-wrap"></div>
        <div class="field-row"><div class="field-group"><label data-i18n="labelDate">Date</label><input type="date" id="expense-date" required></div></div>
        <div class="field-group"><label data-i18n="labelRemarks">Remarks</label><textarea id="expense-remarks" placeholder="Optional note"></textarea></div>
        <div class="denom-cols">
          <div class="denom-section"><h3 data-i18n="labelCashDenoms">Cash Denominations</h3><div class="denom-grid" id="expense-denom-grid"></div></div>
          <div class="denom-section vangti-section" id="expense-vangti-section">
            <div class="vangti-header" id="expense-vangti-toggle">
              <h3 data-i18n="labelChangeReturned">Change Returned</h3>
              <span class="vangti-badge" id="expense-vangti-badge"></span>
              <button type="button" class="vangti-toggle-btn" aria-expanded="false" aria-label="Expand vangti section">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
              </button>
            </div>
            <div class="vangti-body">
              <div class="denom-grid" id="expense-vangti-denom-grid"></div>
              <div class="total-display vangti-total"><span>Change Total</span><div class="counter-display" id="expense-vangti-total">৳0</div></div>
            </div>
          </div>
        </div>
        <div class="total-display"><span data-i18n="labelGrandTotal">Grand Total</span><div class="counter-display" id="expense-total">৳0</div></div>
        <div class="net-line"><span>Net Cash Out (incl. vangti)</span><span class="net-value" id="expense-net-total">৳0</span></div>
        <button type="submit" class="btn-primary" data-i18n="saveExpenseEntry">Save Expense Entry</button>
      </form>
    </section>

    <!-- ============ NOTE SUMMARY ============ -->
    <section id="view-notes" class="view">
      <div class="view-header"><h2 data-i18n="notesTitle">Note Summary</h2><p data-i18n="notesSub">Denomination breakdown of your cash</p></div>
      <div class="chip-row" id="notes-tabs"></div>
      <div class="glass-card card-pad" id="notes-table-wrap"></div>
    </section>

    <!-- ============ HISTORY ============ -->
    <section id="view-history" class="view">
      <div class="view-header"><h2 data-i18n="historyTitle">History</h2><p data-i18n="historySub">Search up to 3 years of transaction history</p></div>
      <div class="section-title"><h3 data-i18n="sectChangeByPerson">Today's Change by Person</h3></div>
      <div class="glass-card card-pad" id="hist-vangti-list" style="margin-bottom:14px;"></div>
      <div class="glass-card filter-card">
        <div class="field-group" style="margin-bottom:10px;"><input type="text" id="hist-search" placeholder="Search name, category or remarks…"></div>
        <div class="filter-row">
          <select id="hist-type"><option value="">All Types</option><option value="income">Income</option><option value="expense">Expense</option></select>
          <select id="hist-category"><option value="">All Categories</option></select>
        </div>
        <div class="filter-row">
          <div class="field-group" style="margin:0;"><label style="font-size:.68rem;">From</label><input type="date" id="hist-date-from"></div>
          <div class="field-group" style="margin:0;"><label style="font-size:.68rem;">To</label><input type="date" id="hist-date-to"></div>
        </div>
        <div class="filter-row" style="grid-template-columns:1fr;">
          <button class="btn-secondary" id="hist-clear" type="button">Clear Filters</button>
        </div>
        <div class="filter-row" style="grid-template-columns:1fr;margin-bottom:0;">
          <button class="btn-secondary" id="hist-trash-btn" type="button">🗑 View Trash (<span id="trash-count">0</span>)</button>
        </div>
      </div>
      <div class="glass-card card-pad history-table-wrap">
        <table class="hist-table">
          <thead><tr><th>Date</th><th>Type</th><th>Category</th><th>Name</th><th>Amount</th><th>Actions</th></tr></thead>
          <tbody id="hist-body"></tbody>
        </table>
        <div class="empty-note" id="hist-empty" style="display:none;">No transactions match your filters.</div>
        <div class="empty-note" id="hist-truncate-note" style="display:none;color:var(--accent-gold);"></div>
      </div>
    </section>

    <!-- ============ REPORTS ============ -->
    <section id="view-reports" class="view">
      <div class="view-header"><h2 data-i18n="reportsTitle">Reports</h2><p data-i18n="reportsSub">Generate a printable report</p></div>
      <div class="report-btn-grid" id="report-buttons"></div>
      <div id="report-output"></div>
    </section>

    <!-- ============ SETTINGS ============ -->
    <section id="view-settings" class="view">
      <div class="view-header"><h2 data-i18n="settingsTitle">Settings</h2><p data-i18n="settingsSub">Backup, restore &amp; preferences</p></div>
      <div class="glass-card card-pad" style="margin-bottom:14px;">
        <div class="section-title" style="margin:0 0 10px 0;"><h3 data-i18n="sectEmployeeSetup">Employee Setup</h3><button class="link-btn" id="kormi-add-btn" type="button" data-i18n="addEmployee">+ Add Employee</button></div>
        <div id="kormi-setup-list"></div>
      </div>
      <div class="glass-card card-pad" style="margin-bottom:14px;">
        <div class="settings-row"><div><div class="sr-label" data-i18n="settingsDarkMode">Dark Mode</div><div class="sr-sub" data-i18n="settingsDarkModeSub">Switch app theme</div></div><div class="switch" id="settings-theme-switch"></div></div>
        <div class="settings-row"><div><div class="sr-label" data-i18n="settingsLanguage">Language</div><div class="sr-sub" data-i18n="settingsLanguageSub">Switch interface language</div></div><div class="lang-toggle"><button type="button" class="lang-btn" data-lang="en">EN</button><button type="button" class="lang-btn" data-lang="bn">বাং</button></div></div>
        <div class="settings-row"><div><div class="sr-label" data-i18n="settingsExport">Export Backup</div><div class="sr-sub" data-i18n="settingsExportSub">Download all data as JSON</div></div><button class="btn-secondary" style="width:auto;padding:9px 14px;" id="export-btn" data-i18n="settingsExportBtn">Export</button></div>
        <div class="settings-row"><div><div class="sr-label" data-i18n="settingsImport">Import Backup</div><div class="sr-sub" data-i18n="settingsImportSub">Restore data from JSON file</div></div><button class="btn-secondary file-btn" style="width:auto;padding:9px 14px;"><span data-i18n="settingsImportBtn">Import</span><input type="file" id="import-file" accept="application/json"></button></div>
      </div>
      <div class="glass-card card-pad" style="margin-bottom:14px;">
        <div class="settings-row" style="border-bottom:none;padding-bottom:0;">
          <div><div class="sr-label">Local Storage Used</div><div class="sr-sub">History is kept for 3 years on this device</div></div>
          <div style="text-align:right;">
            <div class="counter-display" id="storage-used" style="font-size:1rem;padding:6px 10px;">–</div>
          </div>
        </div>
      </div>
      <div class="glass-card card-pad" style="margin-bottom:14px;">
        <div class="settings-row"><div><div class="sr-label" data-i18n="settingsResetToday">Reset Today's Transactions</div><div class="sr-sub" data-i18n="settingsResetTodaySub">Clears only today's entries &amp; reverses today's cash effect — moved to Trash, recoverable anytime, other days untouched</div></div><button class="btn-danger" style="width:auto;padding:9px 14px;" id="reset-today-btn" data-i18n="settingsResetTodayBtn">Reset Today</button></div>
      </div>
      <div class="glass-card card-pad">
        <div class="settings-row"><div><div class="sr-label" data-i18n="settingsClearAll">Clear All Data</div><div class="sr-sub" data-i18n="settingsClearAllSub">Erase every transaction &amp; note record</div></div><button class="btn-danger" style="width:auto;padding:9px 14px;" id="clear-data-btn" data-i18n="settingsClearAllBtn">Clear</button></div>
      </div>
      <p style="text-align:center;color:var(--text-muted);font-size:.72rem;margin-top:18px;">All data stays on this device — 100% offline, LocalStorage only. It's tied to this browser/app, so an occasional Export Backup is worth keeping as a real file copy.</p>
    </section>

    <footer class="app-footer">
      <div class="footer-rule"></div>
      <p>© <span id="footer-year"></span> · <span data-i18n="footerCredit">Crafted with care by</span> <span class="footer-name">Nayem Hasan</span></p>
    </footer>

  </main>

  <button class="fab" id="fab-btn" title="Quick add">
    <svg viewBox="0 0 24 24" fill="none" stroke="#1a1405" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
  </button>

  <nav class="bottomnav">
    <button class="nav-btn active" data-view="dashboard"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect x="14" y="12" width="7" height="9" rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect></svg><span data-i18n="navHome">Home</span></button>
    <button class="nav-btn" data-view="income"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"></path></svg><span data-i18n="navIncome">Income</span></button>
    <button class="nav-btn" data-view="expense"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"></path></svg><span data-i18n="navExpense">Expense</span></button>
    <button class="nav-btn" data-view="notes"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="10" rx="2"></rect><circle cx="12" cy="12" r="2.4"></circle></svg><span data-i18n="navNotes">Notes</span></button>
    <button class="nav-btn" data-view="history"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 3"></path></svg><span data-i18n="navHistory">History</span></button>
    <button class="nav-btn" data-view="reports"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v15H6z"></path><path d="M14 2v6h6M9 13h6M9 17h6"></path></svg><span data-i18n="navReports">Reports</span></button>
    <button class="nav-btn" data-view="settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg><span data-i18n="navSettings">Settings</span></button>
  </nav>
</div>

<div id="modal-root"></div>
<div id="toast-root"></div>

<script>
(function(){
"use strict";

/* ============================================================
   CONSTANTS
   ============================================================ */
var DENOMS = [1000,500,200,100,50,20,10,5,2,1];
var STORAGE_KEY = 'ccem_state_v1';

var INCOME_CATS = [
  {key:'kormi_aday',label:'Employees',full:'Cash Collection (Employees)',nameLabel:'Employee Name',hasId:true,mode:'kormi-select'},
  {key:'bima',label:'Insurance',full:'Insurance Collection',nameLabel:'Payer / Policy Name',hasId:false,mode:'text',knownKey:'bima'},
  {key:'other_income',label:'Other Income',full:'Other Income',nameLabel:'Income Category',hasId:false,mode:'custom-select',customListKey:'customIncomeCategories'},
  {key:'bank_withdrawal',label:'Bank Withdrawal',full:'Bank Withdrawal',nameLabel:'Bank / Account',hasId:false,mode:'text',knownKey:'bank_withdrawal'}
];

var EXPENSE_CATS = [
  {key:'general_expense',label:'General',full:'General Expense',nameLabel:'Expense Name',mode:'custom-select',customListKey:'customExpenseNames'},
  {key:'bank_deposit',label:'Bank Deposit',full:'Bank Deposit',nameLabel:'Bank / Account',mode:'text',knownKey:'bank_deposit'},
  {key:'loan_disbursement',label:'Loan Disbursement',full:'Loan Disbursement',nameLabel:'Borrower Name',mode:'text',knownKey:'loan_disbursement'},
  {key:'savings_return',label:'Savings Return',full:'Savings Return',nameLabel:'Member Name',mode:'text',knownKey:'savings_return'}
];

var ALL_CATS = INCOME_CATS.concat(EXPENSE_CATS);

/* ============================================================
   STATE
   ============================================================ */
function zeroDenoms(){
  var o = {};
  DENOMS.forEach(function(d){ o[d] = 0; });
  return o;
}

function defaultState(){
  return {
    theme:'dark',
    language:'en',
    transactions:[],
    deletedTransactions:[],
    noteInventory: zeroDenoms(),
    incomeNotesLifetime: zeroDenoms(),
    expenseNotesLifetime: zeroDenoms(),
    vangtiNotesLifetime: zeroDenoms(),
    totalIncomeLifetime:0,
    totalExpenseLifetime:0,
    totalVangtiLifetime:0,
    totalTransactionCount:0,
    customIncomeCategories:[],
    customExpenseNames:['Office Rent','Electric Bill','Stationery','Fuel','Tea Bill'],
    knownNames:{},
    kormiTotals:{},
    kormiList:[],
    bimaTotals:{},
    loanTotals:{}
  };
}

var state = defaultState();
var activeIncomeCat = INCOME_CATS[0].key;
var activeExpenseCat = EXPENSE_CATS[0].key;
var activeNotesTab = 'current';

/* ============================================================
   PERFORMANCE: data versioning & save debounce
   ============================================================ */
var _dataVersion = 0;
var _lastDashboardVersion = -1;
var _saveTimeout = null;
var _historySearchTimeout = null;

function scheduleSave(){
  if(_saveTimeout) clearTimeout(_saveTimeout);
  _saveTimeout = setTimeout(function(){
    try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
    catch(e){ toast('Could not save data — storage may be full', 'error'); }
    _saveTimeout = null;
  }, 400);
}

function flushSave(){
  if(_saveTimeout){ clearTimeout(_saveTimeout); _saveTimeout = null; }
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
  catch(e){ toast('Could not save data — storage may be full', 'error'); }
}

function saveState(){
  flushSave();
}

function loadState(){
  try{
    var raw = localStorage.getItem(STORAGE_KEY);
    if(raw){
      var parsed = JSON.parse(raw);
      state = Object.assign(defaultState(), parsed);
      DENOMS.forEach(function(d){
        if(typeof state.noteInventory[d] !== 'number') state.noteInventory[d]=0;
        if(typeof state.incomeNotesLifetime[d] !== 'number') state.incomeNotesLifetime[d]=0;
        if(typeof state.expenseNotesLifetime[d] !== 'number') state.expenseNotesLifetime[d]=0;
        if(!state.vangtiNotesLifetime || typeof state.vangtiNotesLifetime[d] !== 'number'){
          state.vangtiNotesLifetime = state.vangtiNotesLifetime || {};
          state.vangtiNotesLifetime[d] = 0;
        }
      });
      if(typeof state.totalVangtiLifetime !== 'number') state.totalVangtiLifetime = 0;
      if(!Array.isArray(state.deletedTransactions)) state.deletedTransactions = [];
      if(!state.kormiTotals || typeof state.kormiTotals !== 'object') state.kormiTotals = {};
      if(!Array.isArray(state.kormiList)) state.kormiList = [];
      if(state.language !== 'en' && state.language !== 'bn') state.language = 'en';
      if(!state.bimaTotals || typeof state.bimaTotals !== 'object') state.bimaTotals = {};
      if(!state.loanTotals || typeof state.loanTotals !== 'object') state.loanTotals = {};
      // Best-effort rebuild of kormi/bima/loan totals for backups saved before these features existed
      if(Object.keys(state.kormiTotals).length===0 && state.transactions.length){
        state.transactions.forEach(function(t){
          if(t.type==='income' && t.categoryKey==='kormi_aday'){
            state.kormiTotals[t.name] = (state.kormiTotals[t.name]||0) + t.total;
          }
        });
      }
      if(Object.keys(state.bimaTotals).length===0 && state.transactions.length){
        state.transactions.forEach(function(t){
          if(t.type==='income' && t.categoryKey==='bima'){
            state.bimaTotals[t.name] = (state.bimaTotals[t.name]||0) + t.total;
          }
        });
      }
      if(Object.keys(state.loanTotals).length===0 && state.transactions.length){
        state.transactions.forEach(function(t){
          if(t.type==='expense' && t.categoryKey==='loan_disbursement'){
            state.loanTotals[t.name] = (state.loanTotals[t.name]||0) + t.total;
          }
        });
      }
    }
  }catch(e){ state = defaultState(); }
}

/* ============================================================
   UTILITIES
   ============================================================ */
function qs(sel, root){ return (root||document).querySelector(sel); }
function qsa(sel, root){ return Array.prototype.slice.call((root||document).querySelectorAll(sel)); }

function escapeHtml(str){
  return String(str==null?'':str).replace(/[&<>"']/g, function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}

function formatMoney(n){
  n = Math.round(n||0);
  return '৳' + n.toLocaleString('en-IN');
}

function netAmount(t){
  return t.total - (t.vangtiTotal||0);
}

function formatDateKey(d){
  var y=d.getFullYear(), m=String(d.getMonth()+1).padStart(2,'0'), day=String(d.getDate()).padStart(2,'0');
  return y+'-'+m+'-'+day;
}

function todayKey(){ return formatDateKey(new Date()); }

function daysAgoKey(n){
  var d = new Date();
  d.setDate(d.getDate()-n);
  return formatDateKey(d);
}

function uid(){ return 'tx'+Date.now()+Math.random().toString(36).slice(2,8); }

function catMeta(key){
  for(var i=0;i<ALL_CATS.length;i++){ if(ALL_CATS[i].key===key) return ALL_CATS[i]; }
  return null;
}

function inventoryTotal(inv){
  var sum = 0;
  for(var i=0;i<DENOMS.length;i++){ sum += DENOMS[i] * (inv[DENOMS[i]]||0); }
  return sum;
}

function formatTime(ts){
  var d = new Date(ts);
  return d.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:true});
}

/* ============================================================
   TOAST / CONFIRM / INPUT DIALOG
   ============================================================ */
function toast(msg, type){
  var root = qs('#toast-root');
  var el = document.createElement('div');
  el.className = 'toast' + (type ? ' toast-'+type : '');
  el.textContent = msg;
  root.appendChild(el);
  requestAnimationFrame(function(){ el.classList.add('show'); });
  setTimeout(function(){
    el.classList.remove('show');
    setTimeout(function(){ el.remove(); }, 300);
  }, 2600);
}

function confirmDialog(message, opts){
  opts = opts || {};
  return new Promise(function(resolve){
    var root = qs('#modal-root');
    root.innerHTML =
      '<div class="modal-overlay"><div class="modal glass-card">'+
      '<h3>'+escapeHtml(opts.title||'Please confirm')+'</h3>'+
      '<p style="color:var(--text-muted);font-size:.88rem;">'+escapeHtml(message)+'</p>'+
      '<div class="modal-actions">'+
      '<button class="btn-secondary" id="confirm-cancel">Cancel</button>'+
      '<button class="'+(opts.danger?'btn-danger':'btn-primary')+'" id="confirm-ok">'+escapeHtml(opts.okText||'Confirm')+'</button>'+
      '</div></div></div>';
    qs('#confirm-cancel').onclick = function(){ root.innerHTML=''; resolve(false); };
    qs('#confirm-ok').onclick = function(){ root.innerHTML=''; resolve(true); };
  });
}

function inputDialog(title, placeholder){
  return new Promise(function(resolve){
    var root = qs('#modal-root');
    root.innerHTML =
      '<div class="modal-overlay"><div class="modal glass-card">'+
      '<h3>'+escapeHtml(title)+'</h3>'+
      '<input type="text" class="text-input" id="input-dialog-field" placeholder="'+escapeHtml(placeholder||'')+'">'+
      '<div class="modal-actions">'+
      '<button class="btn-secondary" id="input-cancel">Cancel</button>'+
      '<button class="btn-primary" id="input-ok">Add</button>'+
      '</div></div></div>';
    var field = qs('#input-dialog-field');
    setTimeout(function(){ field.focus(); }, 50);
    function cleanup(){ root.innerHTML=''; }
    qs('#input-cancel').onclick = function(){ cleanup(); resolve(null); };
    qs('#input-ok').onclick = function(){ var v=field.value.trim(); cleanup(); resolve(v||null); };
    field.addEventListener('keydown', function(e){
      if(e.key==='Enter'){ e.preventDefault(); qs('#input-ok') && qs('#input-ok').click(); }
    });
  });
}

function kormiDialog(existing){
  return new Promise(function(resolve){
    var root = qs('#modal-root');
    var isEdit = !!existing;
    root.innerHTML =
      '<div class="modal-overlay"><div class="modal glass-card">'+
      '<h3>'+(isEdit?'Edit Employee':'Add Employee')+'</h3>'+
      '<div class="field-group" style="margin-top:10px;"><label>Name</label><input type="text" class="text-input" id="kormi-dialog-name" placeholder="e.g. Rahim Uddin" value="'+(isEdit?escapeHtml(existing.name):'')+'"></div>'+
      '<div class="field-group"><label>ID No.</label><input type="text" class="text-input" id="kormi-dialog-id" placeholder="e.g. EMP-014" value="'+(isEdit?escapeHtml(existing.empId||''):'')+'"></div>'+
      '<div class="modal-actions">'+
      '<button class="btn-secondary" id="kormi-dialog-cancel">Cancel</button>'+
      '<button class="btn-primary" id="kormi-dialog-ok">'+(isEdit?'Save':'Add')+'</button>'+
      '</div></div></div>';
    var nameField = qs('#kormi-dialog-name');
    var idField = qs('#kormi-dialog-id');
    setTimeout(function(){ nameField.focus(); }, 50);
    function cleanup(){ root.innerHTML=''; }
    qs('#kormi-dialog-cancel').onclick = function(){ cleanup(); resolve(null); };
    qs('#kormi-dialog-ok').onclick = function(){
      var name = nameField.value.trim();
      var empId = idField.value.trim();
      if(!name){ toast('Please enter a name', 'error'); return; }
      cleanup();
      resolve({name:name, empId:empId});
    };
    [nameField, idField].forEach(function(f){
      f.addEventListener('keydown', function(e){
        if(e.key==='Enter'){ e.preventDefault(); qs('#kormi-dialog-ok') && qs('#kormi-dialog-ok').click(); }
      });
    });
  });
}

/* ============================================================
   VIEW SWITCHING
   ============================================================ */
function switchView(name){
  qsa('.view').forEach(function(v){ v.classList.remove('active'); });
  var target = qs('#view-'+name);
  if(target) target.classList.add('active');
  qsa('.nav-btn').forEach(function(b){ b.classList.toggle('active', b.dataset.view===name); });
  window.scrollTo({top:0, behavior:'smooth'});
  if(name==='history') renderHistory();
  if(name==='notes') renderNoteSummary();
  if(name==='dashboard') renderDashboard();
  if(name==='settings'){ renderKormiSetupList(); renderStorageUsage(); }
}
window.switchView = switchView;

qsa('.nav-btn').forEach(function(btn){
  btn.addEventListener('click', function(){ switchView(btn.dataset.view); });
});

/* ============================================================
   THEME
   ============================================================ */
var SUN_PATH = '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>';
var MOON_PATH = '<path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"></path>';

function applyTheme(){
  document.documentElement.setAttribute('data-theme', state.theme);
  qs('#theme-icon').innerHTML = state.theme==='dark' ? MOON_PATH : SUN_PATH;
}

function toggleTheme(){
  state.theme = state.theme==='dark' ? 'light' : 'dark';
  saveState();
  applyTheme();
}
qs('#theme-toggle').addEventListener('click', toggleTheme);
qs('#settings-theme-switch').addEventListener('click', toggleTheme);

/* ============================================================
   LANGUAGE (EN / বাংলা)
   ============================================================ */
var I18N = {
  en: {
    navHome:'Home', navIncome:'Income', navExpense:'Expense', navNotes:'Notes',
    navHistory:'History', navReports:'Reports', navSettings:'Settings',

    dashTitle:'Dashboard', dashSub:"Live overview of today's cash position",
    incomeTitle:'Income', incomeSub:'Record cash collections by denomination',
    expenseTitle:'Expense', expenseSub:'Record cash paid out by denomination',
    notesTitle:'Note Summary', notesSub:'Denomination breakdown of your cash',
    historyTitle:'History', historySub:'Search up to 3 years of transaction history',
    reportsTitle:'Reports', reportsSub:'Generate a printable report',
    settingsTitle:'Settings', settingsSub:'Backup, restore & preferences',

    sectEmployeeCollection:"Today's Employee Collection",
    sectInsuranceCollection:"Today's Insurance Collection",
    sectLoanDisbursement:"Today's Loan Disbursement",
    sectRevenueStamp:'Revenue Stamp',
    sectRecentTx:'Recent Transactions',
    seeAll:'See all',
    sectChangeByPerson:"Today's Change by Person",
    sectEmployeeSetup:'Employee Setup',
    addEmployee:'+ Add Employee',

    statTodayCollection:"Today's Collection", statTodayExpense:"Today's Expense",
    statCurrentBalance:'Current Cash Balance', statCashInHand:'Cash in Hand',
    statTotalTx:'Total Transactions',

    labelDate:'Date', labelRemarks:'Remarks',
    labelCashDenoms:'Cash Denominations', labelChangeReturned:'Change Returned',
    labelGrandTotal:'Grand Total',
    saveIncomeEntry:'Save Income Entry', saveExpenseEntry:'Save Expense Entry',

    settingsDarkMode:'Dark Mode', settingsDarkModeSub:'Switch app theme',
    settingsLanguage:'Language', settingsLanguageSub:'Switch interface language',
    settingsExport:'Export Backup', settingsExportSub:'Download all data as JSON', settingsExportBtn:'Export',
    settingsImport:'Import Backup', settingsImportSub:'Restore data from JSON file', settingsImportBtn:'Import',
    settingsResetToday:"Reset Today's Transactions",
    settingsResetTodaySub:"Clears only today's entries & reverses today's cash effect — moved to Trash, recoverable anytime, other days untouched",
    settingsResetTodayBtn:'Reset Today',
    settingsClearAll:'Clear All Data', settingsClearAllSub:'Erase every transaction & note record', settingsClearAllBtn:'Clear',

    footerCredit:'Crafted with care by'
  },
  bn: {
    navHome:'হোম', navIncome:'আয়', navExpense:'ব্যয়', navNotes:'নোট',
    navHistory:'ইতিহাস', navReports:'রিপোর্ট', navSettings:'সেটিংস',

    dashTitle:'ড্যাশবোর্ড', dashSub:'আজকের ক্যাশ পরিস্থিতির সরাসরি ওভারভিউ',
    incomeTitle:'আয়', incomeSub:'নোট অনুযায়ী ক্যাশ কালেকশন লিখুন',
    expenseTitle:'ব্যয়', expenseSub:'নোট অনুযায়ী প্রদত্ত ক্যাশ লিখুন',
    notesTitle:'নোট সামারি', notesSub:'আপনার ক্যাশের ডিনোমিনেশন ব্রেকডাউন',
    historyTitle:'ইতিহাস', historySub:'৩ বছর পর্যন্ত লেনদেনের ইতিহাস খুঁজুন',
    reportsTitle:'রিপোর্ট', reportsSub:'প্রিন্টযোগ্য রিপোর্ট তৈরি করুন',
    settingsTitle:'সেটিংস', settingsSub:'ব্যাকআপ, রিস্টোর ও পছন্দসমূহ',

    sectEmployeeCollection:'আজকের কর্মী কালেকশন',
    sectInsuranceCollection:'আজকের বিমা আদায়',
    sectLoanDisbursement:'আজকের লোন বিতরণ',
    sectRevenueStamp:'রেভিনিউ স্ট্যাম্প',
    sectRecentTx:'সাম্প্রতিক লেনদেন',
    seeAll:'সব দেখুন',
    sectChangeByPerson:'আজকের ভাংতি ব্যক্তি অনুযায়ী',
    sectEmployeeSetup:'কর্মী সেটআপ',
    addEmployee:'+ কর্মী যোগ করুন',

    statTodayCollection:'আজকের কালেকশন', statTodayExpense:'আজকের ব্যয়',
    statCurrentBalance:'বর্তমান ক্যাশ ব্যালেন্স', statCashInHand:'হাতে থাকা টাকা',
    statTotalTx:'মোট লেনদেন',

    labelDate:'তারিখ', labelRemarks:'মন্তব্য',
    labelCashDenoms:'ক্যাশ ডিনোমিনেশন', labelChangeReturned:'ভাংতি ফেরত',
    labelGrandTotal:'গ্র্যান্ড টোটাল',
    saveIncomeEntry:'আয় এন্ট্রি সেভ করুন', saveExpenseEntry:'ব্যয় এন্ট্রি সেভ করুন',

    settingsDarkMode:'ডার্ক মোড', settingsDarkModeSub:'অ্যাপ থিম পরিবর্তন করুন',
    settingsLanguage:'ভাষা', settingsLanguageSub:'ইন্টারফেসের ভাষা পরিবর্তন করুন',
    settingsExport:'ব্যাকআপ এক্সপোর্ট', settingsExportSub:'JSON হিসেবে সব ডেটা ডাউনলোড করুন', settingsExportBtn:'এক্সপোর্ট',
    settingsImport:'ব্যাকআপ ইমপোর্ট', settingsImportSub:'JSON ফাইল থেকে ডেটা রিস্টোর করুন', settingsImportBtn:'ইমপোর্ট',
    settingsResetToday:'আজকের লেনদেন রিসেট করুন',
    settingsResetTodaySub:'শুধু আজকের এন্ট্রি সরাবে ও আজকের ক্যাশের প্রভাব বাতিল করবে — Trash-এ যাবে, যেকোনো সময় ফেরত আনা যাবে, বাকি দিনগুলো অক্ষত থাকবে',
    settingsResetTodayBtn:'আজ রিসেট করুন',
    settingsClearAll:'সব ডেটা মুছুন', settingsClearAllSub:'প্রতিটি লেনদেন ও নোট রেকর্ড মুছে ফেলুন', settingsClearAllBtn:'মুছুন',

    footerCredit:'যত্নসহকারে তৈরি করেছেন'
  }
};

function t(key){
  var lang = (state && state.language) || 'en';
  return (I18N[lang] && I18N[lang][key]) || I18N.en[key] || key;
}

function applyLanguage(){
  var lang = state.language || 'en';
  document.documentElement.setAttribute('lang', lang==='bn' ? 'bn' : 'en');
  qsa('[data-i18n]').forEach(function(el){
    el.textContent = t(el.getAttribute('data-i18n'));
  });
  qsa('.lang-btn').forEach(function(b){
    b.classList.toggle('active', b.dataset.lang === lang);
  });
}

function setLanguage(lang){
  if(lang !== 'en' && lang !== 'bn') return;
  state.language = lang;
  saveState();
  applyLanguage();
  renderAll();
}
qsa('.lang-btn').forEach(function(b){
  b.addEventListener('click', function(){ setLanguage(b.dataset.lang); });
});

/* ============================================================
   DENOMINATION GRID
   ============================================================ */
function buildDenomGrid(container, prefix, totalDisplayEl, onChange, showAvailable){
  var frag = document.createDocumentFragment();
  DENOMS.forEach(function(d){
    var row = document.createElement('div');
    row.className = 'denom-row';
    row.innerHTML =
      '<div class="denom-chip">'+d+'</div>'+
      '<div class="denom-input-wrap">'+
        '<input type="number" min="0" step="1" inputmode="numeric" placeholder="0" data-denom="'+d+'" id="'+prefix+'-d-'+d+'">'+
        (showAvailable ? '<div class="denom-available" id="'+prefix+'-avail-'+d+'"></div>' : '')+
      '</div>'+
      '<div class="denom-subtotal mono" id="'+prefix+'-sub-'+d+'">৳0</div>';
    frag.appendChild(row);
  });
  container.innerHTML = '';
  container.appendChild(frag);
  container.dataset.showAvailable = showAvailable ? '1' : '';

  qsa('input[data-denom]', container).forEach(function(inp){
    inp.addEventListener('input', function(){
      if(inp.value !== '' && Number(inp.value) < 0) inp.value = 0;
      var d = Number(inp.dataset.denom);
      var count = Number(inp.value)||0;
      var subEl = qs('#'+prefix+'-sub-'+d);
      if(subEl) subEl.textContent = formatMoney(d*count);
      if(showAvailable){
        var availEl = qs('#'+prefix+'-avail-'+d);
        if(availEl){
          var have = (state.noteInventory[d]||0);
          availEl.classList.toggle('over', count > have);
        }
      }
      var total = getDenomTotal(container);
      totalDisplayEl.textContent = formatMoney(total);
      if(onChange) onChange(total);
    });
  });

  if(showAvailable) refreshDenomAvailability(container, prefix);
}

var DENOM_AVAILABILITY_GRIDS = [];

function refreshDenomAvailability(container, prefix){
  if(!container || container.dataset.showAvailable !== '1') return;
  DENOMS.forEach(function(d){
    var availEl = qs('#'+prefix+'-avail-'+d);
    if(!availEl) return;
    var have = state.noteInventory[d]||0;
    availEl.textContent = 'Have: '+have.toLocaleString('en-IN');
    var inp = qs('#'+prefix+'-d-'+d);
    var count = inp ? (Number(inp.value)||0) : 0;
    availEl.classList.toggle('over', count > have);
  });
}

function refreshAllDenomAvailability(){
  DENOM_AVAILABILITY_GRIDS.forEach(function(g){ refreshDenomAvailability(g.container, g.prefix); });
}

function getDenomValues(container){
  var vals = {};
  DENOMS.forEach(function(d){
    var inp = qs('input[data-denom="'+d+'"]', container);
    vals[d] = inp ? (Number(inp.value)||0) : 0;
  });
  return vals;
}

function getDenomTotal(container){
  var vals = getDenomValues(container);
  var sum = 0;
  for(var i=0;i<DENOMS.length;i++){ sum += DENOMS[i]*vals[DENOMS[i]]; }
  return sum;
}

function resetDenomGrid(container, totalDisplayEl){
  var prefix = container.id.replace('-denom-grid','');
  qsa('input[data-denom]', container).forEach(function(inp){
    inp.value = '';
    var d = inp.dataset.denom;
    var subEl = qs('#'+prefix+'-sub-'+d);
    if(subEl) subEl.textContent = '৳0';
    var availEl = qs('#'+prefix+'-avail-'+d);
    if(availEl) availEl.classList.remove('over');
  });
  totalDisplayEl.textContent = '৳0';
}

/* ============================================================
   VANGTI SECTION — collapsible, with a live total badge so the
   amount stays visible even while collapsed
   ============================================================ */
function setupVangtiToggle(sectionId, toggleId){
  var section = qs('#'+sectionId);
  var toggleHeader = qs('#'+toggleId);
  if(!section || !toggleHeader) return;
  var btn = toggleHeader.querySelector('.vangti-toggle-btn');
  toggleHeader.addEventListener('click', function(){
    var isExpanded = section.classList.toggle('expanded');
    if(btn) btn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
  });
}
function updateVangtiBadge(badgeId, total){
  var el = qs('#'+badgeId);
  if(!el) return;
  el.textContent = total > 0 ? formatMoney(total) : '';
}

