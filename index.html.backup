/* ============================================================
   LEDGER EFFECTS (apply / reverse) — shared by add, edit, delete, restore
   ============================================================ */
function applyLedgerEffects(tx, reverse){
  var mult = reverse ? -1 : 1;
  var sign = (tx.type === 'income' ? 1 : -1) * mult;
  for(var i=0;i<DENOMS.length;i++){
    var d = DENOMS[i];
    var count = tx.denoms[d] || 0;
    state.noteInventory[d] = (state.noteInventory[d]||0) + sign*count;
    if(tx.type === 'income'){
      state.incomeNotesLifetime[d] = (state.incomeNotesLifetime[d]||0) + mult*count;
    } else {
      state.expenseNotesLifetime[d] = (state.expenseNotesLifetime[d]||0) + mult*count;
    }
  }
  if(tx.type === 'income') state.totalIncomeLifetime += mult*tx.total;
  else state.totalExpenseLifetime += mult*tx.total;

  // Vangti (change returned) — those notes leave the cash box, so they always
  // come OUT of the balance regardless of transaction type.
  if(tx.vangtiDenoms){
    for(var j=0;j<DENOMS.length;j++){
      var vd = DENOMS[j];
      var vcount = tx.vangtiDenoms[vd] || 0;
      state.noteInventory[vd] = (state.noteInventory[vd]||0) - mult*vcount;
      state.vangtiNotesLifetime[vd] = (state.vangtiNotesLifetime[vd]||0) + mult*vcount;
    }
    state.totalVangtiLifetime += mult*(tx.vangtiTotal||0);
  }

  if(tx.categoryKey === 'kormi_aday' && tx.type === 'income'){
    state.kormiTotals[tx.name] = (state.kormiTotals[tx.name]||0) + mult*tx.total;
    if(state.kormiTotals[tx.name] <= 0) delete state.kormiTotals[tx.name];
  }
  if(tx.categoryKey === 'bima' && tx.type === 'income'){
    state.bimaTotals[tx.name] = (state.bimaTotals[tx.name]||0) + mult*tx.total;
    if(state.bimaTotals[tx.name] <= 0) delete state.bimaTotals[tx.name];
  }
  if(tx.categoryKey === 'loan_disbursement' && tx.type === 'expense'){
    state.loanTotals[tx.name] = (state.loanTotals[tx.name]||0) + mult*tx.total;
    if(state.loanTotals[tx.name] <= 0) delete state.loanTotals[tx.name];
  }
  _dataVersion++;
}

/* ============================================================
   COMMIT TRANSACTION (core ledger logic)
   ============================================================ */
function commitTransaction(tx){
  state.transactions.push(tx);
  state.totalTransactionCount += 1;
  applyLedgerEffects(tx, false);
  purgeOldTransactions();
  scheduleSave();
}

function purgeOldTransactions(){
  // Keep a full 3 years of transaction history locally.
  var cutoff = new Date();
  cutoff.setDate(cutoff.getDate()-(365*3));
  cutoff.setHours(0,0,0,0);
  var cutoffKey = formatDateKey(cutoff);
  var lenBefore = state.transactions.length;
  state.transactions = state.transactions.filter(function(t){ return t.date >= cutoffKey; });
  if(state.transactions.length !== lenBefore) _dataVersion++;

  // Trash isn't meant to be a permanent archive — auto-clear anything sitting
  // there for over a year so it doesn't quietly eat storage forever.
  var trashCutoff = Date.now() - (365*24*60*60*1000);
  var trashLenBefore = state.deletedTransactions.length;
  state.deletedTransactions = state.deletedTransactions.filter(function(t){ return (t.deletedAt||0) >= trashCutoff; });
  if(state.deletedTransactions.length !== trashLenBefore) _dataVersion++;
}

/* ============================================================
   DELETE / RESTORE / EDIT TRANSACTIONS
   ============================================================ */
function findTxById(id){
  for(var i=state.transactions.length-1;i>=0;i--){
    if(state.transactions[i].id === id) return state.transactions[i];
  }
  return null;
}

function findDeletedTxById(id){
  for(var i=state.deletedTransactions.length-1;i>=0;i--){
    if(state.deletedTransactions[i].id === id) return state.deletedTransactions[i];
  }
  return null;
}

function deleteTransactionById(txId){
  var idx = -1;
  for(var i=0;i<state.transactions.length;i++){ if(state.transactions[i].id===txId){ idx=i; break; } }
  if(idx===-1) return false;
  var tx = state.transactions[idx];
  state.transactions.splice(idx,1);
  state.totalTransactionCount = Math.max(0, state.totalTransactionCount-1);
  applyLedgerEffects(tx, true);
  tx.deletedAt = Date.now();
  state.deletedTransactions.push(tx);
  scheduleSave();
  return true;
}

function restoreTransactionById(txId){
  var idx = -1;
  for(var i=0;i<state.deletedTransactions.length;i++){ if(state.deletedTransactions[i].id===txId){ idx=i; break; } }
  if(idx===-1) return false;
  var tx = state.deletedTransactions[idx];
  state.deletedTransactions.splice(idx,1);
  delete tx.deletedAt;
  state.transactions.push(tx);
  state.totalTransactionCount += 1;
  applyLedgerEffects(tx, false);
  scheduleSave();
  return true;
}

function purgeDeletedTransactionById(txId){
  var idx = -1;
  for(var i=0;i<state.deletedTransactions.length;i++){ if(state.deletedTransactions[i].id===txId){ idx=i; break; } }
  if(idx===-1) return false;
  state.deletedTransactions.splice(idx,1);
  scheduleSave();
  return true;
}

function updateTransactionById(txId, newData){
  var idx = -1;
  for(var i=0;i<state.transactions.length;i++){ if(state.transactions[i].id===txId){ idx=i; break; } }
  if(idx===-1) return false;
  var tx = state.transactions[idx];
  applyLedgerEffects(tx, true);
  tx.name = newData.name;
  tx.date = newData.date;
  tx.remarks = newData.remarks;
  tx.employeeId = newData.employeeId;
  tx.denoms = newData.denoms;
  tx.total = newData.total;
  tx.vangtiDenoms = newData.vangtiDenoms || zeroDenoms();
  tx.vangtiTotal = newData.vangtiTotal || 0;
  tx.editedAt = Date.now();
  applyLedgerEffects(tx, false);
  scheduleSave();
  return true;
}

function updateTrashCount(){
  var el = qs('#trash-count');
  if(el) el.textContent = state.deletedTransactions.length;
}

/* ============================================================
   TARGETED UPDATE AFTER TRANSACTION
   ============================================================ */
function updateAfterTransaction(){
  renderDashboard();
  updateTrashCount();
  refreshAllDenomAvailability();
  var activeView = qs('.view.active');
  if(activeView){
    var vid = activeView.id;
    if(vid === 'view-notes') renderNoteSummary();
    if(vid === 'view-history') renderHistory();
  }
}

/* ============================================================
   CHARTS (pure inline SVG, no libraries)
   ============================================================ */
var _cachedChartDays = null;
var _cachedChartVersion = -1;

function get7DayBuckets(){
  if(_cachedChartVersion === _dataVersion && _cachedChartDays) return _cachedChartDays;
  var days = [];
  for(var i=6;i>=0;i--){
    var d = new Date();
    d.setDate(d.getDate()-i);
    d.setHours(0,0,0,0);
    days.push(d);
  }
  var result = days.map(function(d){
    var key = formatDateKey(d);
    var dayTx = state.transactions.filter(function(t){ return t.date === key; });
    var income = 0, expense = 0;
    for(var j=0;j<dayTx.length;j++){
      if(dayTx[j].type==='income') income += netAmount(dayTx[j]);
      else expense += netAmount(dayTx[j]);
    }
    return {
      label: d.toLocaleDateString('en-GB',{day:'2-digit',month:'short'}),
      income: income, expense: expense, net: income-expense
    };
  });
  _cachedChartDays = result;
  _cachedChartVersion = _dataVersion;
  return result;
}

/* ============================================================
   DASHBOARD RENDER
   ============================================================ */
var CAT_ICON_SVG = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle></svg>';

function renderKormiTotals(){
  var el = qs('#kormi-total-list');
  if(!el) return;
  var today = todayKey();
  var totals = {};
  state.transactions.forEach(function(t){
    if(t.date===today && t.type==='income' && t.categoryKey==='kormi_aday'){
      if(!totals[t.name]) totals[t.name] = {gross:0, vangti:0};
      totals[t.name].gross += t.total;
      totals[t.name].vangti += (t.vangtiTotal||0);
    }
  });
  var names = Object.keys(totals);
  if(names.length===0){
    el.innerHTML = '<div class="empty-note">No employee collections recorded today.</div>';
    return;
  }
  names.sort(function(a,b){ return (totals[b].gross-totals[b].vangti) - (totals[a].gross-totals[a].vangti); });
  var grand = 0;
  var rows = names.map(function(n){
    var net = totals[n].gross - totals[n].vangti;
    grand += net;
    var sub = totals[n].vangti > 0
      ? 'Collected '+formatMoney(totals[n].gross)+' · Change '+formatMoney(totals[n].vangti)
      : 'Employee Collection · Today';
    return '<div class="recent-item" style="cursor:default;">'+
      '<div class="recent-icon" style="color:var(--accent-green)">'+CAT_ICON_SVG+'</div>'+
      '<div class="recent-info"><div class="rt">'+escapeHtml(n)+'</div><div class="rs">'+sub+'</div></div>'+
      '<div class="recent-amt income">'+formatMoney(net)+'</div>'+
    '</div>';
  }).join('');
  el.innerHTML = rows +
    '<div class="report-row" style="margin-top:6px;font-weight:700;padding:10px 4px 4px 4px;">'+
    '<span>Today\'s Total ('+names.length+' employee'+(names.length>1?'s':'')+')</span>'+
    '<span class="amt" style="color:var(--accent-gold)">'+formatMoney(grand)+'</span></div>';
}

