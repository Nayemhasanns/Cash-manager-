/* ============================================================
   REVENUE STAMP — auto-calculated from today's loan disbursements
   Rule: loan amount <= 50,000 -> ৳20 stamp
         loan amount  > 50,000 (up to 1,00,000 and above) -> ৳50 stamp
   ============================================================ */
function revenueStampFor(loanAmount){
  return loanAmount <= 50000 ? 20 : 50;
}

function renderRevenueStamp(){
  var amtEl = qs('#revenue-stamp-amount');
  var subEl = qs('#revenue-stamp-sub');
  if(!amtEl) return;
  var today = todayKey();
  var todaysLoans = state.transactions.filter(function(t){
    return t.date===today && t.type==='expense' && t.categoryKey==='loan_disbursement';
  });
  if(todaysLoans.length===0){
    amtEl.textContent = formatMoney(0);
    subEl.textContent = 'No loan disbursement posted today';
    return;
  }
  var total = 0;
  var count20 = 0, count50 = 0;
  todaysLoans.forEach(function(t){
    var stamp = revenueStampFor(t.total);
    total += stamp;
    if(stamp===20) count20++; else count50++;
  });
  amtEl.textContent = formatMoney(total);
  var parts = [];
  if(count50) parts.push(count50+' loan'+(count50>1?'s':'')+' × ৳50');
  if(count20) parts.push(count20+' loan'+(count20>1?'s':'')+' × ৳20');
  subEl.textContent = 'Based on '+todaysLoans.length+' loan'+(todaysLoans.length>1?'s':'')+' today — '+parts.join(', ');
}

/* ============================================================
   KORMI SETUP (Settings)
   ============================================================ */
function renderStorageUsage(){
  var el = qs('#storage-used');
  if(!el) return;
  try{
    var raw = localStorage.getItem(STORAGE_KEY) || '';
    var bytes = new Blob([raw]).size;
    var label;
    if(bytes < 1024) label = bytes+' B';
    else if(bytes < 1024*1024) label = (bytes/1024).toFixed(1)+' KB';
    else label = (bytes/(1024*1024)).toFixed(2)+' MB';
    el.textContent = label;
  } catch(e){
    el.textContent = '–';
  }
}

function renderKormiSetupList(){
  var el = qs('#kormi-setup-list');
  if(!el) return;
  if(state.kormiList.length===0){
    el.innerHTML = '<div class="empty-note">No employees added yet — tap "+ Add Employee" to set one up.</div>';
    return;
  }
  var frag = document.createDocumentFragment();
  state.kormiList.forEach(function(k){
    var row = document.createElement('div');
    row.className = 'kormi-row';
    row.innerHTML =
      '<div class="kr-info"><div class="kr-name">'+escapeHtml(k.name)+'</div><div class="kr-id">'+(k.empId?escapeHtml(k.empId):'No ID set')+'</div></div>'+
      '<div class="kr-actions">'+
        '<button type="button" class="kr-btn" data-action="edit" title="Edit"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>'+
        '<button type="button" class="kr-btn danger" data-action="delete" title="Delete"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16z"></path></svg></button>'+
      '</div>';
    row.dataset.kormiId = k.id;
    frag.appendChild(row);
  });
  el.innerHTML = '';
  el.appendChild(frag);
}

qs('#kormi-setup-list').addEventListener('click', async function(e){
  var btn = e.target.closest('.kr-btn');
  if(!btn) return;
  var row = e.target.closest('.kormi-row');
  var kormiId = row.dataset.kormiId;
  var idx = state.kormiList.findIndex(function(k){ return k.id===kormiId; });
  if(idx===-1) return;

  if(btn.dataset.action==='edit'){
    var result = await kormiDialog(state.kormiList[idx]);
    if(result){
      state.kormiList[idx].name = result.name;
      state.kormiList[idx].empId = result.empId;
      flushSave();
      renderKormiSetupList();
      renderIncomeNameField();
      toast('Employee updated', 'success');
    }
  } else if(btn.dataset.action==='delete'){
    var ok = await confirmDialog('Remove "'+state.kormiList[idx].name+'" from your employee list? Past transactions under this name are not affected.', {title:'Remove employee?', okText:'Remove', danger:true});
    if(ok){
      state.kormiList.splice(idx,1);
      flushSave();
      renderKormiSetupList();
      renderIncomeNameField();
      toast('Employee removed', 'success');
    }
  }
});

qs('#kormi-add-btn').addEventListener('click', async function(){
  var result = await kormiDialog(null);
  if(result){
    state.kormiList.push({id:uid(), name:result.name, empId:result.empId});
    flushSave();
    renderKormiSetupList();
    renderIncomeNameField();
    toast('Employee added', 'success');
  }
});

function renderDashboard(){
  var today = todayKey();
  var todayTx = state.transactions.filter(function(t){ return t.date===today; });
  var todayIncome = 0, todayExpense = 0;
  for(var i=0;i<todayTx.length;i++){
    if(todayTx[i].type==='income') todayIncome += netAmount(todayTx[i]);
    else todayExpense += netAmount(todayTx[i]);
  }
  var balance = inventoryTotal(state.noteInventory);

  qs('#stat-today-income').textContent = formatMoney(todayIncome);
  qs('#stat-today-expense').textContent = formatMoney(todayExpense);
  qs('#stat-balance').textContent = formatMoney(balance);
  qs('#stat-cash-hand').textContent = formatMoney(balance);
  qs('#stat-total-tx').textContent = state.totalTransactionCount.toLocaleString('en-IN');

  renderKormiTotals();
  renderBimaTotals();
  renderLoanTotals();
  renderRevenueStamp();

  var recent = state.transactions.slice().sort(function(a,b){ return b.createdAt - a.createdAt; }).slice(0,6);
  var listEl = qs('#recent-list');
  if(recent.length===0){
    listEl.innerHTML = '<div class="empty-note">No transactions yet — tap the + button to add one.</div>';
  } else {
    var frag = document.createDocumentFragment();
    for(var i=0;i<recent.length;i++){
      var t = recent[i];
      var color = t.type==='income' ? 'var(--accent-green)' : 'var(--accent-red)';
      var item = document.createElement('div');
      item.className = 'recent-item';
      item.dataset.txId = t.id;
      var sub = escapeHtml(t.categoryLabel)+' · '+t.date + (t.vangtiTotal>0 ? ' · Change '+formatMoney(t.vangtiTotal) : '');
      item.innerHTML =
        '<div class="recent-icon" style="color:'+color+'">'+CAT_ICON_SVG+'</div>'+
        '<div class="recent-info"><div class="rt">'+escapeHtml(t.name)+'</div><div class="rs">'+sub+'</div></div>'+
        '<div class="recent-amt '+t.type+'">'+(t.type==='income'?'+':'-')+formatMoney(netAmount(t))+'</div>';
      frag.appendChild(item);
    }
    listEl.innerHTML = '';
    listEl.appendChild(frag);
  }
  _lastDashboardVersion = _dataVersion;
}

// Event delegation for recent list clicks
qs('#recent-list').addEventListener('click', function(e){
  var row = e.target.closest('.recent-item');
  if(row && row.dataset.txId){
    openTransactionDetails(row.dataset.txId);
  }
});

/* ============================================================
   NOTE SUMMARY RENDER
   ============================================================ */
function renderNoteSummary(){
  var wrap = qs('#notes-tabs');
  var tabs = [
    {key:'current',label:'Current Cash'},
    {key:'income',label:'Income Notes'},
    {key:'expense',label:'Expense Notes'}
  ];
  var frag = document.createDocumentFragment();
  tabs.forEach(function(t){
    var chip = document.createElement('div');
    chip.className = 'chip'+(t.key===activeNotesTab?' active':'');
    chip.dataset.tab = t.key;
    chip.textContent = t.label;
    chip.addEventListener('click', function(){ activeNotesTab = t.key; renderNoteSummary(); });
    frag.appendChild(chip);
  });
  wrap.innerHTML = '';
  wrap.appendChild(frag);

  var data = activeNotesTab==='current' ? state.noteInventory :
             activeNotesTab==='income' ? state.incomeNotesLifetime : state.expenseNotesLifetime;

  var rows = DENOMS.map(function(d){
    var count = data[d]||0;
    return '<tr><td class="mono">৳'+d+'</td><td class="num mono">'+count.toLocaleString('en-IN')+'</td><td class="num mono">'+formatMoney(d*count)+'</td></tr>';
  }).join('');

  var total = inventoryTotal(data);

  qs('#notes-table-wrap').innerHTML =
    '<table class="note-table">'+
    '<thead><tr><th>Denomination</th><th style="text-align:right;">Notes</th><th style="text-align:right;">Value</th></tr></thead>'+
    '<tbody>'+rows+
    '<tr class="note-total-row"><td colspan="2">Total Cash</td><td class="num">'+formatMoney(total)+'</td></tr>'+
    '</tbody></table>';
}

/* ============================================================
   HISTORY RENDER
   ============================================================ */
function populateHistoryCategoryFilter(){
  var sel = qs('#hist-category');
  var current = sel.value;
  sel.innerHTML = '<option value="">All Categories</option>' + ALL_CATS.map(function(c){
    return '<option value="'+c.key+'">'+escapeHtml(c.full)+'</option>';
  }).join('');
  sel.value = current;
}

var ICON_EYE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1.5"></circle><path d="M2 12s4-8 10-8 10 8 10 8-4 8-10 8-10-8-10-8z"></path></svg>';
var ICON_PENCIL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>';
var ICON_TRASH = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>';
var ICON_RESTORE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path></svg>';

function renderHistoryVangti(){
  var el = qs('#hist-vangti-list');
  if(!el) return;
  var today = todayKey();
  var byPerson = {};
  state.transactions.forEach(function(t){
    if(t.date===today && t.vangtiTotal && t.vangtiTotal > 0){
      if(!byPerson[t.name]) byPerson[t.name] = {total:0, count:0, types:{}};
      byPerson[t.name].total += t.vangtiTotal;
      byPerson[t.name].count += 1;
      byPerson[t.name].types[t.type] = (byPerson[t.name].types[t.type]||0) + t.vangtiTotal;
    }
  });
  var names = Object.keys(byPerson);
  if(names.length===0){
    el.innerHTML = '<div class="empty-note">No change (vangti) given to anyone today.</div>';
    return;
  }
  names.sort(function(a,b){ return byPerson[b].total - byPerson[a].total; });
  var grand = 0;
  var rows = names.map(function(n){
    var info = byPerson[n];
    grand += info.total;
    var sub = info.count+' transaction'+(info.count>1?'s':'')+' today';
    return '<div class="recent-item" style="cursor:default;">'+
      '<div class="recent-icon" style="color:var(--accent-red)">'+CAT_ICON_SVG+'</div>'+
      '<div class="recent-info"><div class="rt">'+escapeHtml(n)+'</div><div class="rs">'+sub+'</div></div>'+
      '<div class="recent-amt expense">'+formatMoney(info.total)+'</div>'+
    '</div>';
  }).join('');
  el.innerHTML = rows +
    '<div class="report-row" style="margin-top:6px;font-weight:700;padding:10px 4px 4px 4px;">'+
    '<span>Today\'s Total Change ('+names.length+' person'+(names.length>1?'s':'')+')</span>'+
    '<span class="amt" style="color:var(--accent-red)">'+formatMoney(grand)+'</span></div>';
}

var HIST_ROW_CAP = 400;
var HIST_DEFAULT_DAYS = 30;

function renderHistory(){
  renderHistoryVangti();
  populateHistoryCategoryFilter();
  var search = qs('#hist-search').value.trim().toLowerCase();
  var typeFilter = qs('#hist-type').value;
  var catFilter = qs('#hist-category').value;
  var dateFrom = qs('#hist-date-from').value;
  var dateTo = qs('#hist-date-to').value;

  var rows = state.transactions.slice().sort(function(a,b){ return b.createdAt - a.createdAt; }).filter(function(t){
    if(typeFilter && t.type !== typeFilter) return false;
    if(catFilter && t.categoryKey !== catFilter) return false;
    if(dateFrom && t.date < dateFrom) return false;
    if(dateTo && t.date > dateTo) return false;
    if(search){
      var hay = (t.name+' '+t.categoryLabel+' '+(t.remarks||'')+' '+(t.employeeId||'')).toLowerCase();
      if(hay.indexOf(search) === -1) return false;
    }
    return true;
  });

  var body = qs('#hist-body');
  qs('#hist-empty').style.display = rows.length===0 ? 'block' : 'none';

  var truncated = rows.length > HIST_ROW_CAP;
  var toRender = truncated ? rows.slice(0, HIST_ROW_CAP) : rows;

  var frag = document.createDocumentFragment();
  for(var i=0;i<toRender.length;i++){
    var t = toRender[i];
    var tr = document.createElement('tr');
    tr.dataset.txId = t.id;
    tr.innerHTML =
      '<td>'+t.date+'</td>'+
      '<td><span class="tag '+t.type+'">'+(t.type==='income'?'Income':'Expense')+'</span></td>'+
      '<td>'+escapeHtml(t.categoryLabel)+'</td>'+
      '<td>'+escapeHtml(t.name)+(t.employeeId?' <span style="color:var(--text-muted)">('+escapeHtml(t.employeeId)+')</span>':'')+'</td>'+
      '<td class="amt-cell" style="color:'+(t.type==='income'?'var(--accent-green)':'var(--accent-red)')+'">'+(t.type==='income'?'+':'-')+formatMoney(netAmount(t))+
        (t.vangtiTotal>0 ? '<div style="font-size:.66rem;color:var(--text-muted);font-weight:400;">−'+formatMoney(t.vangtiTotal)+' vangti</div>' : '')+
      '</td>'+
      '<td><div class="row-actions">'+
        '<button class="view-detail-btn" title="View Details" data-action="view" data-tx-id="'+t.id+'">'+ICON_EYE+'</button>'+
        '<button class="view-detail-btn edit-btn" title="Edit" data-action="edit" data-tx-id="'+t.id+'">'+ICON_PENCIL+'</button>'+
        '<button class="view-detail-btn delete-btn" title="Delete" data-action="delete" data-tx-id="'+t.id+'">'+ICON_TRASH+'</button>'+
      '</div></td>';
    frag.appendChild(tr);
  }
  body.innerHTML = '';
  body.appendChild(frag);

  var noteEl = qs('#hist-truncate-note');
  if(truncated){
    noteEl.style.display = 'block';
    noteEl.textContent = 'Showing the most recent '+HIST_ROW_CAP+' of '+rows.length.toLocaleString('en-IN')+' matching transactions — narrow your date range or search to see the rest.';
  } else {
    noteEl.style.display = 'none';
  }
}

// Event delegation for history table clicks
qs('#hist-body').addEventListener('click', function(e){
  var btn = e.target.closest('button[data-action]');
  if(btn){
    e.stopPropagation();
    var txId = btn.dataset.txId;
    var action = btn.dataset.action;
    if(action==='view') openTransactionDetails(txId);
    if(action==='edit') openEditTransaction(txId);
    if(action==='delete') confirmDeleteTransaction(txId);
    return;
  }
  var row = e.target.closest('tr[data-tx-id]');
  if(row) openTransactionDetails(row.dataset.txId);
});

async function confirmDeleteTransaction(txId){
  var tx = findTxById(txId);
  if(!tx) return;
  var ok = await confirmDialog('Move "'+tx.name+'" ('+formatMoney(tx.total)+') to Trash? You can restore it later from Trash.', {title:'Delete transaction?',okText:'Delete',danger:true});
  if(ok){
    deleteTransactionById(txId);
    toast('Transaction moved to trash', 'success');
    updateAfterTransaction();
  }
}

// Debounced history search
function debouncedRenderHistory(){
  if(_historySearchTimeout) clearTimeout(_historySearchTimeout);
  _historySearchTimeout = setTimeout(renderHistory, 280);
}

qs('#hist-date-from').value = daysAgoKey(HIST_DEFAULT_DAYS);

['hist-search','hist-type','hist-category','hist-date-from','hist-date-to'].forEach(function(id){
  var el = qs('#'+id);
  if(id==='hist-search'){
    el.addEventListener('input', debouncedRenderHistory);
  } else {
    el.addEventListener('input', renderHistory);
    el.addEventListener('change', renderHistory);
  }
});
qs('#hist-clear').addEventListener('click', function(){
  qs('#hist-search').value=''; qs('#hist-type').value=''; qs('#hist-category').value='';
  qs('#hist-date-from').value=''; qs('#hist-date-to').value='';
  renderHistory();
});
qs('#hist-trash-btn').addEventListener('click', openTrashModal);

/* ============================================================
   TRASH MODAL
   ============================================================ */
function openTrashModal(){
  var root = qs('#modal-root');

  function render(){
    var items = state.deletedTransactions.slice().sort(function(a,b){ return b.deletedAt - a.deletedAt; });
    var rowsHtml = items.length ? items.map(function(t){
      var color = t.type==='income' ? 'var(--accent-green)' : 'var(--accent-red)';
      var sub = escapeHtml(t.categoryLabel)+' · '+t.date + (t.vangtiTotal>0 ? ' · Change '+formatMoney(t.vangtiTotal) : '');
      return '<div class="recent-item" style="cursor:default;">'+
        '<div class="recent-icon" style="color:'+color+'">'+CAT_ICON_SVG+'</div>'+
        '<div class="recent-info"><div class="rt">'+escapeHtml(t.name)+'</div><div class="rs">'+sub+'</div></div>'+
        '<div class="recent-amt '+t.type+'">'+(t.type==='income'?'+':'-')+formatMoney(netAmount(t))+'</div>'+
        '<div class="row-actions" style="margin-left:8px;">'+
          '<button class="view-detail-btn restore-btn" title="Restore" data-restore="'+t.id+'">'+ICON_RESTORE+'</button>'+
          '<button class="view-detail-btn delete-btn" title="Delete Permanently" data-purge="'+t.id+'">'+ICON_TRASH+'</button>'+
        '</div>'+
      '</div>';
    }).join('') : '<div class="empty-note">Trash is empty.</div>';

    root.innerHTML =
      '<div class="tx-detail-overlay" id="trash-overlay"><div class="tx-detail-modal">'+
      '<div class="tx-header"><h3>Trash ('+items.length+')</h3><button class="tx-close-btn" id="trash-close-btn">✕</button></div>'+
      '<div class="tx-body">'+rowsHtml+
        (items.length ? '<button class="btn-danger" id="trash-empty-btn" style="margin-top:14px;">Empty Trash Permanently</button>' : '')+
      '</div>'+
      '</div></div>';

    function closeTrash(){ root.innerHTML=''; }
    qs('#trash-close-btn').onclick = closeTrash;
    qs('#trash-overlay').addEventListener('click', function(e){ if(e.target===qs('#trash-overlay')) closeTrash(); });

    qsa('button[data-restore]', root).forEach(function(btn){
      btn.onclick = function(){
        restoreTransactionById(btn.dataset.restore);
        toast('Transaction restored', 'success');
        updateAfterTransaction();
        render();
      };
    });
    qsa('button[data-purge]', root).forEach(function(btn){
      btn.onclick = async function(){
        var ok = await confirmDialog('Permanently delete this transaction? This cannot be undone.', {title:'Delete permanently?',okText:'Delete forever',danger:true});
        if(ok){
          purgeDeletedTransactionById(btn.dataset.purge);
          toast('Permanently deleted', 'success');
          updateTrashCount();
          render();
        }
      };
    });
    if(items.length){
      qs('#trash-empty-btn').onclick = async function(){
        var ok = await confirmDialog('Permanently delete all '+items.length+' item(s) in Trash? This cannot be undone.', {title:'Empty trash?',okText:'Empty trash',danger:true});
        if(ok){
          state.deletedTransactions = [];
          scheduleSave();
          toast('Trash emptied', 'success');
          updateTrashCount();
          render();
        }
      };
    }
  }

  render();
}

/* ============================================================
   EDIT TRANSACTION MODAL
   ============================================================ */
function openEditTransaction(txId){
  var tx = findTxById(txId);
  if(!tx){ toast('Transaction not found', 'error'); return; }
  var catInfo = catMeta(tx.categoryKey);
  var hasId = !!(catInfo && catInfo.hasId);
  var root = qs('#modal-root');

  root.innerHTML =
    '<div class="tx-detail-overlay" id="edit-tx-overlay"><div class="tx-detail-modal">'+
    '<div class="tx-header"><h3>Edit Transaction</h3><button class="tx-close-btn" id="edit-close-btn">✕</button></div>'+
    '<div class="tx-body">'+
      '<div class="tx-badge-large '+(tx.type==='income'?'income':'expense')+'">'+escapeHtml(tx.categoryLabel)+'</div>'+
      '<div class="field-group"><label>'+escapeHtml(catInfo?catInfo.nameLabel:'Name')+'</label><input type="text" class="text-input" id="edit-name" value="'+escapeHtml(tx.name)+'"></div>'+
      (hasId ? '<div class="field-group"><label>Employee ID (optional)</label><input type="text" class="text-input" id="edit-emp-id" value="'+escapeHtml(tx.employeeId||'')+'"></div>' : '')+
      '<div class="field-group"><label>Date</label><input type="date" class="text-input" id="edit-date" value="'+tx.date+'"></div>'+
      '<div class="field-group"><label>Remarks</label><textarea id="edit-remarks">'+escapeHtml(tx.remarks||'')+'</textarea></div>'+
      '<div class="denom-cols">'+
        '<div class="denom-section"><h3>Cash Denominations</h3><div class="denom-grid" id="edit-denom-grid"></div></div>'+
        '<div class="denom-section vangti-section" id="edit-vangti-section">'+
          '<div class="vangti-header" id="edit-vangti-toggle">'+
            '<h3>Change Returned</h3>'+
            '<span class="vangti-badge" id="edit-vangti-badge"></span>'+
            '<button type="button" class="vangti-toggle-btn" aria-expanded="false" aria-label="Expand vangti section">'+
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>'+
            '</button>'+
          '</div>'+
          '<div class="vangti-body">'+
            '<div class="denom-grid" id="edit-vangti-denom-grid"></div>'+
            '<div class="total-display vangti-total"><span>Change Total</span><div class="counter-display" id="edit-vangti-total">৳0</div></div>'+
          '</div>'+
        '</div>'+
      '</div>'+
      '<div class="total-display"><span>Grand Total</span><div class="counter-display" id="edit-total">৳0</div></div>'+
    '</div>'+
    '<div class="tx-footer">'+
      '<button class="btn-secondary" id="edit-cancel-btn">Cancel</button>'+
      '<button class="btn-primary" id="edit-save-btn">Save Changes</button>'+
    '</div>'+
    '</div></div>';

  var editGrid = qs('#edit-denom-grid');
  var editTotalEl = qs('#edit-total');
  var editVangtiGrid = qs('#edit-vangti-denom-grid');
  var editVangtiTotalEl = qs('#edit-vangti-total');
  buildDenomGrid(editGrid, 'edit', editTotalEl, null, tx.type==='expense');
  buildDenomGrid(editVangtiGrid, 'edit-vangti', editVangtiTotalEl, null, true);

  DENOMS.forEach(function(d){
    var count = tx.denoms[d] || 0;
    if(count){
      var inp = qs('#edit-d-'+d);
      if(inp) inp.value = count;
      var subEl = qs('#edit-sub-'+d);
      if(subEl) subEl.textContent = formatMoney(d*count);
    }
    var vcount = (tx.vangtiDenoms && tx.vangtiDenoms[d]) || 0;
    if(vcount){
      var vinp = qs('#edit-vangti-d-'+d);
      if(vinp) vinp.value = vcount;
      var vsubEl = qs('#edit-vangti-sub-'+d);
      if(vsubEl) vsubEl.textContent = formatMoney(d*vcount);
    }
  });
  editTotalEl.textContent = formatMoney(tx.total);
  editVangtiTotalEl.textContent = formatMoney(tx.vangtiTotal||0);
  updateVangtiBadge('edit-vangti-badge', tx.vangtiTotal||0);
  setupVangtiToggle('edit-vangti-section', 'edit-vangti-toggle');
  if(tx.vangtiTotal && tx.vangtiTotal > 0){
    var editVangtiSection = qs('#edit-vangti-section');
    var editVangtiBtn = qs('#edit-vangti-toggle .vangti-toggle-btn');
    if(editVangtiSection) editVangtiSection.classList.add('expanded');
    if(editVangtiBtn) editVangtiBtn.setAttribute('aria-expanded', 'true');
  }

  function closeEdit(){ root.innerHTML=''; }
  qs('#edit-close-btn').onclick = closeEdit;
  qs('#edit-cancel-btn').onclick = closeEdit;
  qs('#edit-tx-overlay').addEventListener('click', function(e){ if(e.target===qs('#edit-tx-overlay')) closeEdit(); });

  qs('#edit-save-btn').onclick = function(){
    var name = qs('#edit-name').value.trim();
    var date = qs('#edit-date').value;
    var remarks = qs('#edit-remarks').value.trim();
    var empId = hasId && qs('#edit-emp-id') ? qs('#edit-emp-id').value.trim() : (tx.employeeId||'');
    var denoms = getDenomValues(editGrid);
    var total = getDenomTotal(editGrid);
    var vangtiDenoms = getDenomValues(editVangtiGrid);
    var vangtiTotal = getDenomTotal(editVangtiGrid);

    if(!name){ toast('Please enter a name', 'error'); return; }
    if(!date){ toast('Please pick a date', 'error'); return; }
    if(total <= 0){ toast('Enter at least one note quantity', 'error'); return; }
    if(vangtiTotal > total){ toast('Change cannot be more than the total', 'error'); return; }

    updateTransactionById(txId, {name:name, date:date, remarks:remarks, employeeId:empId, denoms:denoms, total:total, vangtiDenoms:vangtiDenoms, vangtiTotal:vangtiTotal});
    closeEdit();
    toast('Transaction updated', 'success');
    updateAfterTransaction();
  };
}

/* ============================================================
   TRANSACTION DETAILS MODAL
   ============================================================ */
function openTransactionDetails(txId){
  var tx = findTxById(txId);
  if(!tx){ toast('Transaction not found', 'error'); return; }

  var isIncome = tx.type === 'income';
  var badgeClass = isIncome ? 'income' : 'expense';
  var flowLabel = isIncome ? 'Received' : 'Paid';
  var flowColor = isIncome ? 'var(--accent-green)' : 'var(--accent-red)';

  // Build denomination rows
  var denomRows = '';
  for(var i=0;i<DENOMS.length;i++){
    var d = DENOMS[i];
    var count = tx.denoms[d] || 0;
    var subtotal = d * count;
    var zeroClass = count === 0 ? ' zero-row' : '';
    denomRows += '<tr class="'+zeroClass+'"><td class="mono">৳'+d+'</td><td class="num mono">× '+count.toLocaleString('en-IN')+'</td><td class="num mono">= '+formatMoney(subtotal)+'</td></tr>';
  }

  var catInfo = catMeta(tx.categoryKey);
  var hasEmployee = !!(catInfo && catInfo.hasId && tx.employeeId);

  var hasVangti = tx.vangtiTotal && tx.vangtiTotal > 0;
  var vangtiRows = '';
  if(hasVangti){
    for(var k=0;k<DENOMS.length;k++){
      var vd = DENOMS[k];
      var vcount = (tx.vangtiDenoms && tx.vangtiDenoms[vd]) || 0;
      if(!vcount) continue;
      vangtiRows += '<tr><td class="mono">৳'+vd+'</td><td class="num mono">× '+vcount.toLocaleString('en-IN')+'</td><td class="num mono">= '+formatMoney(vd*vcount)+'</td></tr>';
    }
  }
  var netAmount = isIncome ? (tx.total - (tx.vangtiTotal||0)) : (tx.total + (tx.vangtiTotal||0));

  var root = qs('#modal-root');
  root.innerHTML =
    '<div class="tx-detail-overlay" id="tx-detail-overlay">'+
    '<div class="tx-detail-modal">'+
      '<div class="tx-header">'+
        '<h3>Transaction Details</h3>'+
        '<button class="tx-close-btn" id="tx-close-btn" title="Close">✕</button>'+
      '</div>'+
      '<div class="tx-body">'+
        '<span class="tx-badge-large '+badgeClass+'">'+
          '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">'+
          (isIncome ? '<path d="M12 19V5M5 12l7-7 7 7"></path>' : '<path d="M12 5v14M5 12l7 7 7-7"></path>')+
          '</svg> '+
          escapeHtml(flowLabel)+' — '+escapeHtml(tx.categoryLabel)+
        '</span>'+

        '<div class="tx-meta-grid">'+
          '<div class="tx-meta-item"><span class="tx-meta-label">Transaction ID</span><span class="tx-meta-value mono" style="font-size:.78rem;">'+escapeHtml(tx.id)+'</span></div>'+
          '<div class="tx-meta-item"><span class="tx-meta-label">Type</span><span class="tx-meta-value" style="color:'+flowColor+'">'+(isIncome?'Income':'Expense')+'</span></div>'+
          '<div class="tx-meta-item"><span class="tx-meta-label">Category</span><span class="tx-meta-value">'+escapeHtml(tx.categoryLabel)+'</span></div>'+
          '<div class="tx-meta-item"><span class="tx-meta-label">Name</span><span class="tx-meta-value">'+escapeHtml(tx.name)+'</span></div>'+
          (hasEmployee ? '<div class="tx-meta-item"><span class="tx-meta-label">Employee Name</span><span class="tx-meta-value">'+escapeHtml(tx.name)+'</span></div>' : '')+
          (hasEmployee ? '<div class="tx-meta-item"><span class="tx-meta-label">Employee ID</span><span class="tx-meta-value mono">'+escapeHtml(tx.employeeId||'—')+'</span></div>' : '')+
          '<div class="tx-meta-item"><span class="tx-meta-label">Date</span><span class="tx-meta-value">'+escapeHtml(tx.date)+'</span></div>'+
          '<div class="tx-meta-item"><span class="tx-meta-label">Time</span><span class="tx-meta-value mono">'+formatTime(tx.createdAt)+'</span></div>'+
          '<div class="tx-meta-item tx-meta-full"><span class="tx-meta-label">Remarks</span><span class="tx-meta-value">'+(tx.remarks ? escapeHtml(tx.remarks) : '<span style="color:var(--text-muted);font-style:italic;">No remarks</span>')+'</span></div>'+
          '<div class="tx-meta-item tx-meta-full"><span class="tx-meta-label">Total Amount</span><span class="tx-meta-value" style="font-size:1.1rem;color:'+flowColor+'">'+formatMoney(tx.total)+'</span></div>'+
          (hasVangti ? '<div class="tx-meta-item tx-meta-full"><span class="tx-meta-label">Net Cash '+(isIncome?'In':'Out')+' (after change)</span><span class="tx-meta-value" style="font-size:1.05rem;color:var(--accent-gold);">'+formatMoney(netAmount)+'</span></div>' : '')+
        '</div>'+

        '<div style="margin-top:8px;">'+
          '<h4 style="font-size:.82rem;color:var(--text-muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px;">Denomination Breakdown</h4>'+
          '<table class="tx-denom-table">'+
            '<thead><tr><th>Note</th><th style="text-align:right;">Count</th><th style="text-align:right;">Value</th></tr></thead>'+
            '<tbody>'+denomRows+
            '<tr class="grand-total"><td colspan="2">Grand Total</td><td class="num">'+formatMoney(tx.total)+'</td></tr>'+
            '</tbody>'+
          '</table>'+
        '</div>'+
        (hasVangti ?
        '<div style="margin-top:14px;">'+
          '<h4 style="font-size:.82rem;color:var(--accent-red);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px;">Change Returned</h4>'+
          '<table class="tx-denom-table">'+
            '<thead><tr><th>Note</th><th style="text-align:right;">Count</th><th style="text-align:right;">Value</th></tr></thead>'+
            '<tbody>'+vangtiRows+
            '<tr class="grand-total"><td colspan="2">Change Total</td><td class="num" style="color:var(--accent-red);">'+formatMoney(tx.vangtiTotal)+'</td></tr>'+
            '</tbody>'+
          '</table>'+
        '</div>' : '')+
      '</div>'+
      '<div class="tx-footer">'+
        '<button class="btn-secondary" id="tx-edit-btn">✏️ Edit</button>'+
        '<button class="btn-danger" id="tx-delete-btn">🗑 Delete</button>'+
        '<button class="btn-secondary" id="tx-print-btn">🖨 Print</button>'+
        '<button class="btn-secondary" id="tx-copy-btn">📋 Copy Details</button>'+
        '<button class="btn-primary" id="tx-close-bottom-btn">Close</button>'+
      '</div>'+
    '</div></div>';

  // Close handlers
  function closeModal(){
    root.innerHTML = '';
    document.body.classList.remove('tx-printing');
  }
  qs('#tx-close-btn').onclick = closeModal;
  qs('#tx-close-bottom-btn').onclick = closeModal;
  qs('#tx-detail-overlay').addEventListener('click', function(e){
    if(e.target === qs('#tx-detail-overlay')) closeModal();
  });

  // Edit handler
  qs('#tx-edit-btn').onclick = function(){
    closeModal();
    openEditTransaction(tx.id);
  };

  // Delete handler
  qs('#tx-delete-btn').onclick = async function(){
    var ok = await confirmDialog('Move "'+tx.name+'" ('+formatMoney(tx.total)+') to Trash? You can restore it later from Trash.', {title:'Delete transaction?',okText:'Delete',danger:true});
    if(ok){
      closeModal();
      deleteTransactionById(tx.id);
      toast('Transaction moved to trash', 'success');
      updateAfterTransaction();
    }
  };

  // Print handler
  qs('#tx-print-btn').onclick = function(){
    document.body.classList.add('tx-printing');
    setTimeout(function(){ window.print(); }, 150);
    setTimeout(function(){ document.body.classList.remove('tx-printing'); }, 800);
  };

  // Copy handler
  qs('#tx-copy-btn').onclick = function(){
    var text = 'Transaction Details\n==================\n'+
      'ID: '+tx.id+'\n'+
      'Type: '+(isIncome?'Income (Received)':'Expense (Paid)')+'\n'+
      'Category: '+tx.categoryLabel+'\n'+
      'Name: '+tx.name+'\n'+
      (hasEmployee ? 'Employee Name: '+tx.name+'\n' : '')+
      (hasEmployee ? 'Employee ID: '+(tx.employeeId||'—')+'\n' : '')+
      'Date: '+tx.date+'\n'+
      'Time: '+formatTime(tx.createdAt)+'\n'+
      'Remarks: '+(tx.remarks||'None')+'\n'+
      'Total: '+formatMoney(tx.total)+'\n\n'+
      'Denomination Breakdown:\n';
    for(var i=0;i<DENOMS.length;i++){
      var d = DENOMS[i];
      var c = tx.denoms[d]||0;
      text += '  ৳'+d+' × '+c+' = '+formatMoney(d*c)+'\n';
    }
    text += '------------------------\nGrand Total: '+formatMoney(tx.total);

    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(function(){
        toast('Transaction details copied to clipboard', 'success');
      }).catch(function(){
        fallbackCopy(text);
      });
    } else {
      fallbackCopy(text);
    }
  };

  function fallbackCopy(text){
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.cssText = 'position:fixed;left:-9999px;top:-9999px;';
    document.body.appendChild(ta);
    ta.select();
    try{ document.execCommand('copy'); toast('Transaction details copied', 'success'); }
    catch(e){ toast('Could not copy — please select and copy manually', 'error'); }
    document.body.removeChild(ta);
  }

  // Keyboard: Escape to close
  function onKeyDown(e){
    if(e.key==='Escape'){ closeModal(); document.removeEventListener('keydown', onKeyDown); }
  }
  document.addEventListener('keydown', onKeyDown);
}

/* ============================================================
   REPORTS
   ============================================================ */
var REPORT_TYPES = [
  {key:'daily',label:'Daily Report'},
  {key:'weekly',label:'Weekly Report'},
  {key:'income',label:'Income Report'},
  {key:'expense',label:'Expense Report'},
  {key:'balance',label:'Cash Balance Report'},
  {key:'denomination',label:'Denomination Report'}
];

function renderReportButtons(){
  var frag = document.createDocumentFragment();
  REPORT_TYPES.forEach(function(r){
    var btn = document.createElement('div');
    btn.className = 'glass-card report-btn';
    btn.dataset.report = r.key;
    btn.innerHTML =
      '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v15H6z"></path><path d="M14 2v6h6"></path></svg>'+
      '<span>'+r.label+'</span>';
    btn.addEventListener('click', function(){ generateReport(r.key); });
    frag.appendChild(btn);
  });
  var container = qs('#report-buttons');
  container.innerHTML = '';
  container.appendChild(frag);
}

function reportRowsHtml(rows){
  return rows.map(function(r){
    return '<div class="report-row"><span>'+escapeHtml(r.label)+'</span><span class="amt">'+r.value+'</span></div>';
  }).join('');
}

function generateReport(type){
  var out = qs('#report-output');
  var html = '';
  var today = todayKey();

  if(type==='daily'){
    var todayTx = state.transactions.filter(function(t){ return t.date===today; });
    var inc = 0, exp = 0;
    for(var i=0;i<todayTx.length;i++){
      if(todayTx[i].type==='income') inc += netAmount(todayTx[i]);
      else exp += netAmount(todayTx[i]);
    }
    html = '<div class="glass-card report-block"><h3>Daily Report</h3><div class="sub">'+today+'</div>'+
      reportRowsHtml([
        {label:'Total Collection',value:formatMoney(inc)},
        {label:'Total Expense',value:formatMoney(exp)},
        {label:'Net Cash Today',value:formatMoney(inc-exp)},
        {label:'Transactions Today',value:todayTx.length}
      ])+'</div>';
  }

  if(type==='weekly'){
    var nets = get7DayBuckets();
    var rows = nets.map(function(n){ return {label:n.label,value:formatMoney(n.income)+' / '+formatMoney(n.expense)}; });
    var totalInc = 0, totalExp = 0;
    for(var j=0;j<nets.length;j++){ totalInc += nets[j].income; totalExp += nets[j].expense; }
    html = '<div class="glass-card report-block"><h3>Weekly Report</h3><div class="sub">Last 7 days · Income / Expense</div>'+
      reportRowsHtml(rows)+
      '<div class="report-row" style="margin-top:8px;font-weight:700;"><span>Week Total</span><span class="amt">'+formatMoney(totalInc)+' / '+formatMoney(totalExp)+'</span></div>'+
      '</div>';
  }

  if(type==='income'){
    var byCategory = {};
    state.transactions.filter(function(t){return t.type==='income';}).forEach(function(t){
      byCategory[t.categoryLabel] = (byCategory[t.categoryLabel]||0) + netAmount(t);
    });
    var rows2 = Object.keys(byCategory).map(function(k){ return {label:k,value:formatMoney(byCategory[k])}; });
    if(rows2.length===0) rows2 = [{label:'No income recorded in last 7 days',value:''}];
    html = '<div class="glass-card report-block"><h3>Income Report</h3><div class="sub">By category · last 7 days</div>'+reportRowsHtml(rows2)+'</div>';
  }

  if(type==='expense'){
    var byCategory2 = {};
    state.transactions.filter(function(t){return t.type==='expense';}).forEach(function(t){
      byCategory2[t.categoryLabel] = (byCategory2[t.categoryLabel]||0) + netAmount(t);
    });
    var rows3 = Object.keys(byCategory2).map(function(k){ return {label:k,value:formatMoney(byCategory2[k])}; });
    if(rows3.length===0) rows3 = [{label:'No expense recorded in last 7 days',value:''}];
    html = '<div class="glass-card report-block"><h3>Expense Report</h3><div class="sub">By category · last 7 days</div>'+reportRowsHtml(rows3)+'</div>';
  }

  if(type==='balance'){
    html = '<div class="glass-card report-block"><h3>Cash Balance Report</h3><div class="sub">As of '+today+'</div>'+
      reportRowsHtml([
        {label:'Lifetime Income',value:formatMoney(state.totalIncomeLifetime)},
        {label:'Lifetime Expense',value:formatMoney(state.totalExpenseLifetime)},
        {label:'Current Cash Balance',value:formatMoney(inventoryTotal(state.noteInventory))},
        {label:'Total Transactions',value:state.totalTransactionCount}
      ])+'</div>';
  }

  if(type==='denomination'){
    var rows4 = DENOMS.map(function(d){
      var c = state.noteInventory[d]||0;
      return {label:'৳'+d+' × '+c+' notes',value:formatMoney(d*c)};
    });
    html = '<div class="glass-card report-block"><h3>Denomination Report</h3><div class="sub">Current cash notes on hand</div>'+
      reportRowsHtml(rows4)+
      '<div class="report-row" style="margin-top:8px;font-weight:700;"><span>Total</span><span class="amt">'+formatMoney(inventoryTotal(state.noteInventory))+'</span></div>'+
      '</div>';
  }

  html += '<button class="btn-primary" id="print-report-btn" style="margin-top:4px;">Print / Save as PDF</button>';
  out.innerHTML = html;
  qs('#print-report-btn').addEventListener('click', function(){ window.print(); });
  out.scrollIntoView({behavior:'smooth',block:'nearest'});
}

/* ============================================================
   EXPORT / IMPORT / CLEAR
   ============================================================ */
qs('#export-btn').addEventListener('click', function(){
  var blob = new Blob([JSON.stringify(state, null, 2)], {type:'application/json'});
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url;
  a.download = 'cash-manager-backup-'+todayKey()+'.json';
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
  toast('Backup exported', 'success');
});

qs('#import-file').addEventListener('change', function(e){
  var file = e.target.files[0];
  if(!file) return;
  var reader = new FileReader();
  reader.onload = function(ev){
    try{
      var data = JSON.parse(ev.target.result);
      if(!data || !Array.isArray(data.transactions)) throw new Error('bad shape');
      state = Object.assign(defaultState(), data);
      if(!Array.isArray(state.deletedTransactions)) state.deletedTransactions = [];
      if(!state.kormiTotals || typeof state.kormiTotals !== 'object') state.kormiTotals = {};
      if(!Array.isArray(state.kormiList)) state.kormiList = [];
      if(state.language !== 'en' && state.language !== 'bn') state.language = 'en';
      if(!state.bimaTotals || typeof state.bimaTotals !== 'object') state.bimaTotals = {};
      if(!state.loanTotals || typeof state.loanTotals !== 'object') state.loanTotals = {};
      _dataVersion++;
      _cachedChartVersion = -1;
      _cachedChartDays = null;
      purgeOldTransactions();
      flushSave();
      applyTheme();
      renderAll();
      toast('Backup imported successfully', 'success');
    }catch(err){
      toast('That file is not a valid backup', 'error');
    }
  };
  reader.readAsText(file);
  e.target.value = '';
});

async function resetAllData(){
  var ok = await confirmDialog('This permanently erases every transaction, note record and category on this device. This cannot be undone.', {title:'Clear all data?',okText:'Erase everything',danger:true});
  if(ok){
    state = defaultState();
    _dataVersion++;
    _cachedChartVersion = -1;
    _cachedChartDays = null;
    flushSave();
    applyTheme();
    renderAll();
    toast('All data cleared', 'success');
  }
  return ok;
}

qs('#clear-data-btn').addEventListener('click', resetAllData);

async function resetTodayTransactions(){
  var today = todayKey();
  var todaysTx = state.transactions.filter(function(t){ return t.date===today; });
  if(todaysTx.length===0){ toast('No transactions recorded today', 'error'); return; }
  var ok = await confirmDialog(
    'This moves all '+todaysTx.length+' of today\'s transactions to Trash and reverses their effect on your cash balance — as if today\'s entries hadn\'t happened yet. They stay recoverable from History → View Trash. Other days\' data and reports are not touched.',
    {title:'Reset today\'s transactions?', okText:'Reset today', danger:true}
  );
  if(ok){
    todaysTx.forEach(function(t){ deleteTransactionById(t.id); });
    flushSave();
    renderAll();
    toast('Today\'s transactions cleared', 'success');
  }
}

qs('#reset-today-btn').addEventListener('click', resetTodayTransactions);

/* Secondary quick-access: long-press the header logo (0.8s) to reset all data */
(function(){
  var brandIcon = qs('.brand-icon');
  if(!brandIcon) return;
  var pressTimer = null;

  function startPress(){
    if(pressTimer) return;
    brandIcon.style.transition = 'transform .8s ease, filter .8s ease';
    brandIcon.style.transform = 'scale(0.82)';
    brandIcon.style.filter = 'brightness(1.4)';
    pressTimer = setTimeout(function(){
      pressTimer = null;
      brandIcon.style.transition = 'transform .2s ease, filter .2s ease';
      brandIcon.style.transform = 'scale(1)';
      brandIcon.style.filter = 'none';
      resetAllData();
    }, 800);
  }
  function cancelPress(){
    if(pressTimer){ clearTimeout(pressTimer); pressTimer = null; }
    brandIcon.style.transition = 'transform .2s ease, filter .2s ease';
    brandIcon.style.transform = 'scale(1)';
    brandIcon.style.filter = 'none';
  }

  brandIcon.style.cursor = 'pointer';
  brandIcon.title = 'Hold 0.8s to reset all data';
  brandIcon.addEventListener('pointerdown', startPress);
  brandIcon.addEventListener('pointerup', cancelPress);
  brandIcon.addEventListener('pointerleave', cancelPress);
  brandIcon.addEventListener('pointercancel', cancelPress);
})();

/* ============================================================
   FAB QUICK-ADD SHEET
   ============================================================ */
qs('#fab-btn').addEventListener('click', function(){
  var root = qs('#modal-root');
  root.innerHTML =
    '<div class="modal-overlay"><div class="modal glass-card">'+
    '<h3>Quick Add</h3>'+
    '<div class="sheet-option" id="qa-income">'+
      '<div class="so-icon" style="color:var(--accent-green)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 19V5M5 12l7-7 7 7"></path></svg></div>'+
      '<span>Add Income Entry</span></div>'+
    '<div class="sheet-option" id="qa-expense">'+
      '<div class="so-icon" style="color:var(--accent-red)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12l7 7 7-7"></path></svg></div>'+
      '<span>Add Expense Entry</span></div>'+
    '<button class="btn-secondary" id="qa-cancel">Cancel</button>'+
    '</div></div>';
  qs('#qa-income').onclick = function(){ root.innerHTML=''; switchView('income'); };
  qs('#qa-expense').onclick = function(){ root.innerHTML=''; switchView('expense'); };
  qs('#qa-cancel').onclick = function(){ root.innerHTML=''; };
});

/* ============================================================
   RENDER ALL / INIT
   ============================================================ */
function renderAll(){
  renderIncomeChips();
  renderIncomeNameField();
  renderExpenseChips();
  renderExpenseNameField();
  renderDashboard();
  renderNoteSummary();
  renderHistory();
  renderReportButtons();
  renderKormiSetupList();
  updateTrashCount();
  _lastDashboardVersion = _dataVersion;
}

function init(){
  loadState();
  purgeOldTransactions();
  flushSave();
  applyTheme();
  applyLanguage();
  renderAll();
  refreshAllDenomAvailability();
  var footerYearEl = qs('#footer-year');
  if(footerYearEl) footerYearEl.textContent = new Date().getFullYear();
  setTimeout(function(){
    var loader = qs('#loader');
    loader.style.transition = 'opacity .35s ease';
    loader.style.opacity = '0';
    setTimeout(function(){ loader.style.display='none'; }, 360);
  }, 420);
}

init();

})();
</script>
</body>
</html>